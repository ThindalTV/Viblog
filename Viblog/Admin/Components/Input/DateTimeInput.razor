@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

<div class="datetime-input-wrapper">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="input-label">@Label</label>
    }
    
    <input id="@Id"
           type="datetime-local"
           value="@FormatValue()"
           @onchange="HandleChange"
           class="@CssClass"
           disabled="@Disabled"
           required="@Required" />

    @if (ValidationFor != null)
    {
        <ValidationMessage For="@ValidationFor" />
    }
</div>

@code {
    /// <summary>
    /// Label text to display above the input
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Whether the input is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Whether the input is required
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// The input value (non-nullable)
    /// </summary>
    [Parameter]
    public DateTimeOffset Value { get; set; }

    /// <summary>
    /// Event callback when value changes
    /// </summary>
    [Parameter]
    public EventCallback<DateTimeOffset> ValueChanged { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Expression for validation messages
    /// </summary>
    [Parameter]
    public Expression<Func<DateTimeOffset>>? ValidationFor { get; set; }

    /// <summary>
    /// Unique identifier for the input element
    /// </summary>
    private string Id { get; set; } = Guid.NewGuid().ToString("N");

    private string FormatValue()
    {
        // Format as HTML5 datetime-local format (yyyy-MM-ddTHH:mm)
        return Value.LocalDateTime.ToString("yyyy-MM-ddTHH:mm");
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        var stringValue = e.Value?.ToString();
        
        if (!string.IsNullOrWhiteSpace(stringValue) && DateTime.TryParse(stringValue, out var dateTime))
        {
            var newValue = new DateTimeOffset(dateTime, DateTimeOffset.Now.Offset);
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);
        }
    }
}
