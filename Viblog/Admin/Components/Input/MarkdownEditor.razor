@using Viblog.Admin.Components.Input
@using Viblog.Admin.Components.MediaLibrary
@using Viblog.Admin.Services
@using Viblog.Admin.Services.Dialogs
@using Viblog.Infrastructure.Services
@using Viblog.Shared.Configuration
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop

@inject IMarkdownService MarkdownService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IOptions<ViblogOptions> ViblogOptions
@implements IAsyncDisposable

@if (!string.IsNullOrWhiteSpace(ViblogOptions.Value.PreviewStylesheetPath))
{
    <HeadContent>
        <link rel="stylesheet" href="@ViblogOptions.Value.PreviewStylesheetPath" />
    </HeadContent>
}

<div class="markdown-editor">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="editor-label-row">
            <label class="editor-label">@Label</label>
            <button type="button" class="btn-markdown-help" @onclick="ShowCheatsheet" title="Markdown Syntax Help">
                ?
            </button>
        </div>
    }

    <div class="editor-container">
        <div class="editor-panel" @ref="_editorPanel">
            <div class="panel-header">
                <span>Edit</span>
                <button type="button" class="btn-insert-media" title="Insert media"
                        @onclick="() => _mediaPickerDialog?.Open()"
                        disabled="@Disabled">
                    &#128444;
                </button>
            </div>
            <TextInput Value="@Markdown"
                      ValueChanged="@HandleMarkdownChanged"
                      Multiline="true"
                      Rows="@Rows"
                      Placeholder="@Placeholder"
                      Disabled="@Disabled"
                      Required="@Required" />
        </div>
        
        <div class="preview-panel">
            <div class="panel-header">Preview</div>
            <div class="preview-container">
                @if (!string.IsNullOrWhiteSpace(RenderedContent))
                {
                    @((MarkupString)RenderedContent)
                }
                else
                {
                    <p class="preview-empty">Nothing to preview yet. Start writing in the editor.</p>
                }
            </div>
        </div>
    </div>
</div>

<InlineMediaPickerDialog @ref="_mediaPickerDialog" OnInsertMarkdown="InsertMarkdownAsync" />

@code {
    /// <summary>
    /// Label text to display above the editor
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Placeholder text for the markdown input
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Write your markdown content here...";

    /// <summary>
    /// Number of rows for the textarea
    /// </summary>
    [Parameter]
    public int Rows { get; set; } = 20;

    /// <summary>
    /// Whether the editor is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Whether the input is required
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// The markdown content
    /// </summary>
    [Parameter]
    public string Markdown { get; set; } = string.Empty;

    /// <summary>
    /// Event callback when markdown changes
    /// </summary>
    [Parameter]
    public EventCallback<string> MarkdownChanged { get; set; }

    /// <summary>
    /// The rendered HTML content
    /// </summary>
    [Parameter]
    public string RenderedContent { get; set; } = string.Empty;

    /// <summary>
    /// Event callback when rendered content changes
    /// </summary>
    [Parameter]
    public EventCallback<string> RenderedContentChanged { get; set; }

    private async Task HandleMarkdownChanged(string newMarkdown)
    {
        // Update markdown value
        Markdown = newMarkdown;
        await MarkdownChanged.InvokeAsync(newMarkdown);

        // Generate rendered content
        await RenderMarkdown(newMarkdown);
    }

    private async Task RenderMarkdown(string markdown)
    {
        if (!string.IsNullOrWhiteSpace(markdown))
        {
            RenderedContent = MarkdownService.RenderToHtml(markdown);
            await RenderedContentChanged.InvokeAsync(RenderedContent);
        }
        else
        {
            RenderedContent = string.Empty;
            await RenderedContentChanged.InvokeAsync(string.Empty);
        }
    }

    private void ShowCheatsheet()
    {
        DialogService.ShowMarkdownSyntaxDialog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "/_content/Viblog/js/markdownEditor.js");
        }
    }

    private async Task InsertMarkdownAsync(string markdown)
    {
        if (_jsModule == null || Disabled)
            return;

        var newValue = await _jsModule.InvokeAsync<string?>("insertAtCursor", _editorPanel, markdown);
        if (newValue != null)
            await HandleMarkdownChanged(newValue);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
            await _jsModule.DisposeAsync();
    }

    private InlineMediaPickerDialog? _mediaPickerDialog;
    private ElementReference _editorPanel;
    private IJSObjectReference? _jsModule;
}
