@using Microsoft.Extensions.Logging
@using System.Globalization
@using Viblog.Admin.Models
@using Viblog.Admin.Services
@using Viblog.Helpers
@using Viblog.Infrastructure.Data.Entities
@using Viblog.Infrastructure.Services
@inject IMediaService MediaService
@inject IMediaLibraryBroadcastService BroadcastService
@inject ILogger<FolderSelector> Logger
@implements IAsyncDisposable

<div class="folder-selector">
    <!-- File Type Filter -->
    <div class="filter-section">
        <label>File Type:</label>
        <select @bind="SelectedMediaType" @bind:after="OnFilterChangedAsync">
            <option value="">All Files</option>
            @foreach (var type in Enum.GetValues<MediaTypeCategory>())
            {
                <option value="@type">@MediaTypeHelper.GetDisplayName(type)</option>
            }
        </select>
    </div>

    <!-- Date Folders List -->
    <div class="date-folders">
        <h3>Uploads By Date</h3>
        @if (_isLoading && !_dateFolders.Any())
        {
            <p class="loading-message">Loading...</p>
        }
        else if (!_dateFolders.Any())
        {
            <p class="no-folders">No uploads yet</p>
        }
        else
        {
            <Accordion DataSource="@_accordionData">
                <HeaderTemplate Context="item">
                    <span class="year-label">@item.Key</span>
                </HeaderTemplate>
                <ContentTemplate Context="months">
                    <ul class="month-list">
                        @foreach (var folder in months)
                        {
                            <li class="month-item @(folder.DateFolder == SelectedDateFolder ? "active" : "")"
                                @onclick="() => OnDateFolderSelectedAsync(folder.DateFolder)">
                                <span class="month-name">@GetMonthName(folder.DateFolder)</span>
                            </li>
                        }
                    </ul>
                </ContentTemplate>
            </Accordion>
        }
    </div>
</div>

@code {
    private List<DateFolderInfo> _dateFolders = [];
    private List<AccordionPage<List<DateFolderInfo>>> _accordionData = [];
    private bool _isLoading;
    private MediaTypeCategory? _previousMediaType;
    // Prevents concurrent DB operations on the same scoped DbContext: if a load is
    // already in progress (e.g. triggered by the broadcast cascade), a second call
    // skips immediately rather than starting a concurrent context operation.
    private readonly SemaphoreSlim _loadLock = new(1, 1);

    /// <summary>
    /// Selected media type filter
    /// </summary>
    [Parameter]
    public MediaTypeCategory? SelectedMediaType { get; set; }

    [Parameter]
    public EventCallback<MediaTypeCategory?> SelectedMediaTypeChanged { get; set; }

    /// <summary>
    /// Selected date folder
    /// </summary>
    [Parameter]
    public string? SelectedDateFolder { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedDateFolderChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _previousMediaType = SelectedMediaType;
        BroadcastService.OnFolderContentsChanged += HandleFolderContentsChangedAsync;
        await LoadDateFoldersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Only reload folders if media type changed externally
        if (_previousMediaType != SelectedMediaType)
        {
            _previousMediaType = SelectedMediaType;
            await LoadDateFoldersAsync();
        }
    }

    private async Task LoadDateFoldersAsync()
    {
        if (!await _loadLock.WaitAsync(0))
            return; // Another load is already running on the same DbContext scope

        try
        {
            _isLoading = true;
            var dateFolders = await MediaService.GetDateFoldersAsync(
                SelectedMediaType,
                CancellationToken.None);

            _dateFolders = dateFolders.Select(df => new DateFolderInfo
            {
                DateFolder = df,
                DisplayName = DateFolderInfo.GetDisplayName(df),
                ItemCount = 0
            }).ToList();

            // Transform to accordion data structure
            _accordionData = _dateFolders
                .GroupBy(df => df.DateFolder[..4])
                .Select(g => new AccordionPage<List<DateFolderInfo>>
                {
                    Key = g.Key,
                    Data = g.OrderByDescending(df => df.DateFolder).ToList()
                })
                .ToList();

            // If the currently selected folder is not in the filtered results, clear the selection
            if (SelectedDateFolder != null && !_dateFolders.Any(df => df.DateFolder == SelectedDateFolder))
            {
                await OnDateFolderSelectedAsync(null);
            }
            // Note: We no longer auto-select the first folder on initial load
            // Users should explicitly choose a folder to view its contents
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load date folders");
        }
        finally
        {
            _isLoading = false;
            _loadLock.Release();
        }
    }

    private async Task OnFilterChangedAsync()
    {
        await SelectedMediaTypeChanged.InvokeAsync(SelectedMediaType);
        await LoadDateFoldersAsync();
    }

    private async Task OnDateFolderSelectedAsync(string? dateFolder)
    {
        SelectedDateFolder = dateFolder;
        await SelectedDateFolderChanged.InvokeAsync(dateFolder);
    }

    private static string GetMonthName(string dateFolder)
    {
        if (dateFolder.Length != 6 || !int.TryParse(dateFolder, out _))
        {
            return dateFolder;
        }

        var year = dateFolder[..4];
        var monthNum = int.Parse(dateFolder[4..], CultureInfo.InvariantCulture);
        return new DateTime(int.Parse(year, CultureInfo.InvariantCulture), monthNum, 1)
            .ToString("MMMM", CultureInfo.InvariantCulture);
    }

    private async Task HandleFolderContentsChangedAsync(FolderContentsChangedEventArgs args)
    {
        await InvokeAsync(async () =>
        {
            await LoadDateFoldersAsync();
            StateHasChanged();
        });
    }

    public ValueTask DisposeAsync()
    {
        BroadcastService.OnFolderContentsChanged -= HandleFolderContentsChangedAsync;
        _loadLock.Dispose();
        return ValueTask.CompletedTask;
    }
}
