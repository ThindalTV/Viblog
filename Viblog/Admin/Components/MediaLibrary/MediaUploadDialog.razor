@using Viblog.Infrastructure.Admin.Services
@using Viblog.Infrastructure.Shared.Data.Entities
@inject IMediaLibraryBroadcastService BroadcastService
@inject ILogger<MediaUploadDialog> Logger

@if (IsVisible)
{
    <TelerikWindow Visible="@IsVisible"
                   VisibleChanged="@OnWindowVisibleChanged"
                   Modal="true"
                   Width="700px"
                   Height="auto">
        <WindowTitle>
            <strong>Upload Media Files</strong>
        </WindowTitle>
        <WindowContent>
            <div class="upload-dialog-content">
                <TelerikUpload SaveUrl="@SaveUrl"
                               RemoveUrl="@RemoveUrl"
                               SaveField="file"
                               RemoveField="file"
                               AllowedExtensions="@AllowedExtensions"
                               MaxFileSize="@MaxFileSize"
                               Multiple="true"
                               AutoUpload="false"
                               OnSelect="@OnFileSelect"
                               OnUpload="@OnUploadHandler"
                               OnSuccess="@OnUploadSuccess"
                               OnError="@OnUploadError"
                               OnRemove="@OnRemoveHandler"
                               @ref="@UploadRef">
                </TelerikUpload>

                <div class="upload-info">
                    <span>Images, PDFs, Documents, Videos, Audio</span>
                    <span>Max @(MaxFileSize / 1024 / 1024) MB per file</span>
                </div>

                @if (_successMessages.Any())
                {
                    <div class="success-messages">
                        @foreach (var message in _successMessages)
                        {
                            <div class="success-message">
                                <span class="success-icon">✓</span>
                                @message
                            </div>
                        }
                    </div>
                }

                @if (_errorMessages.Any())
                {
                    <div class="error-messages">
                        @foreach (var error in _errorMessages)
                        {
                            <div class="error-message">@error</div>
                        }
                    </div>
                }

                <div class="dialog-footer">
                    <TelerikButton OnClick="@OnClose"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Base">
                        Close
                    </TelerikButton>
                    <TelerikButton OnClick="@StartUpload"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Enabled="@_hasSelectedFiles">
                        Upload All
                    </TelerikButton>
                </div>
            </div>
        </WindowContent>
    </TelerikWindow>
}

@code {
    private TelerikUpload? UploadRef { get; set; }

    /// <summary>Whether the dialog is visible.</summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>Event callback when visibility changes.</summary>
    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>Event callback when the dialog is closed after uploads.</summary>
    [Parameter]
    public EventCallback OnFilesUploaded { get; set; }

    /// <summary>Optional folder path for uploads (defaults to date-based).</summary>
    [Parameter]
    public string? FolderPath { get; set; }

    /// <summary>Current user identifier.</summary>
    [Parameter]
    public string? UploadedBy { get; set; }

    private List<string> AllowedExtensions =>
    [
        ".jpg", ".jpeg", ".png", ".gif", ".webp",
        ".pdf", ".doc", ".docx", ".xls", ".xlsx",
        ".mp4", ".webm", ".mp3"
    ];

    private int MaxFileSize => 50 * 1024 * 1024; // 50 MB

    private string SaveUrl
    {
        get
        {
            var folderPath = FolderPath ?? DateTimeOffset.UtcNow.ToString("yyyyMM");
            var url = $"/api/media/upload?folderPath={Uri.EscapeDataString(folderPath)}";
            if (!string.IsNullOrEmpty(UploadedBy))
                url += $"&uploadedBy={Uri.EscapeDataString(UploadedBy)}";
            return url;
        }
    }

    private string RemoveUrl => "/api/media/upload/remove";

    // State
    private bool _hasSelectedFiles;
    private bool _isRemoving;
    private List<string> _successMessages = [];
    private List<string> _errorMessages = [];
    private int _uploadedCount;

    private void OnFileSelect(UploadSelectEventArgs args)
    {
        _errorMessages.Clear();
        _hasSelectedFiles = args.Files.Any();
        StateHasChanged();
    }

    private void OnUploadHandler(UploadEventArgs args)
    {
        var folderPath = FolderPath ?? DateTimeOffset.UtcNow.ToString("yyyyMM");
        args.RequestData.Add("folderPath", folderPath);
        if (!string.IsNullOrEmpty(UploadedBy))
            args.RequestData.Add("uploadedBy", UploadedBy);

        Logger.LogInformation("Uploading {FileName} to {FolderPath}",
            args.Files.FirstOrDefault()?.Name, folderPath);
    }

    private async Task OnUploadSuccess(UploadSuccessEventArgs args)
    {
        var fileName = args.Files.FirstOrDefault()?.Name ?? "Unknown file";
        _successMessages.Add($"Successfully uploaded: {fileName}");
        _uploadedCount++;

        Logger.LogInformation("Upload succeeded: {FileName}", fileName);

        // Refresh the media browser immediately without closing the dialog
        await BroadcastService.BroadcastFolderContentsChangedAsync(
            FolderContentsChangedEventArgs.ForAllFolders(FolderChangeType.Upload));

        StateHasChanged();
    }

    private void OnUploadError(UploadErrorEventArgs args)
    {
        // Suppress errors from remove requests — files are already saved
        if (_isRemoving)
        {
            _isRemoving = false;
            return;
        }

        var fileName = args.Files.FirstOrDefault()?.Name ?? "Unknown file";
        _errorMessages.Add($"Failed to upload {fileName}: {args.Request.StatusText}");
        Logger.LogError("Upload failed for {FileName}: {Status}", fileName, args.Request.StatusText);
        StateHasChanged();
    }

    private void OnRemoveHandler(UploadEventArgs args)
    {
        _isRemoving = true;
        Logger.LogInformation("Removing {FileName} from list", args.Files.FirstOrDefault()?.Name);
    }

    private void StartUpload()
    {
        _successMessages.Clear();
        _errorMessages.Clear();
        _uploadedCount = 0;
        UploadRef?.UploadFiles();
    }

    // Called when the TelerikWindow's built-in X button is clicked
    private async Task OnWindowVisibleChanged(bool visible)
    {
        if (!visible)
            await OnClose();
    }

    private async Task OnClose()
    {
        await IsVisibleChanged.InvokeAsync(false);

        if (_uploadedCount > 0)
            await OnFilesUploaded.InvokeAsync();

        _hasSelectedFiles = false;
        _isRemoving = false;
        _successMessages.Clear();
        _errorMessages.Clear();
        _uploadedCount = 0;
    }
}
