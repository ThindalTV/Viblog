@using Microsoft.Extensions.Logging
@using Viblog.Admin.Services
@using Viblog.Admin.Components.Dialogs
@inject IMediaLibraryBroadcastService BroadcastService
@inject ILogger<MediaUploadDialog> Logger
@inject HttpClient Http

<DialogBase @ref="_dialogBase" IsModal="true" CssClass="media-upload-dialog" OnClose="OnClose">
    <Title>
        <strong>Upload Media Files</strong>
    </Title>
    <Content>
        <div class="upload-dialog-content">
            <InputFile OnChange="@OnFilesSelected"
                       multiple
                       accept="@string.Join(",", AllowedExtensions)" />

            <div class="upload-info">
                <span>Images, PDFs, Documents, Videos, Audio</span>
                <span>Max @(MaxFileSize / 1024 / 1024) MB per file</span>
            </div>

            @if (_selectedFiles.Any())
            {
                <div class="selected-files">
                    @foreach (var file in _selectedFiles)
                    {
                        <div class="selected-file">@file.Name (@(file.Size / 1024) KB)</div>
                    }
                </div>
            }

            @if (_successMessages.Any())
            {
                <div class="success-messages">
                    @foreach (var message in _successMessages)
                    {
                        <div class="success-message">
                            <span class="success-icon">✓</span>
                            @message
                        </div>
                    }
                </div>
            }

            @if (_errorMessages.Any())
            {
                <div class="error-messages">
                    @foreach (var error in _errorMessages)
                    {
                        <div class="error-message">@error</div>
                    }
                </div>
            }
        </div>
    </Content>
    <ActionButtons>
        <button class="btn" @onclick="@OnClose">Close</button>
        <button class="btn btn-primary" @onclick="@StartUpload" disabled="@(!_hasSelectedFiles || _isUploading)">
            @(_isUploading ? "Uploading..." : "Upload All")
        </button>
    </ActionButtons>
</DialogBase>

@code {
    private DialogBase? _dialogBase;

    /// <summary>Whether the dialog is visible.</summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>Event callback when visibility changes.</summary>
    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    /// <summary>Event callback when the dialog is closed after uploads.</summary>
    [Parameter]
    public EventCallback OnFilesUploaded { get; set; }

    /// <summary>Optional folder path for uploads (defaults to date-based).</summary>
    [Parameter]
    public string? FolderPath { get; set; }

    /// <summary>Current user identifier.</summary>
    [Parameter]
    public string? UploadedBy { get; set; }

    private List<string> AllowedExtensions =>
    [
        ".jpg", ".jpeg", ".png", ".gif", ".webp",
        ".pdf", ".doc", ".docx", ".xls", ".xlsx",
        ".mp4", ".webm", ".mp3"
    ];

    private int MaxFileSize => 50 * 1024 * 1024; // 50 MB

    private string SaveUrl
    {
        get
        {
            var folderPath = FolderPath ?? DateTimeOffset.UtcNow.ToString("yyyyMM");
            var url = $"/api/media/upload?folderPath={Uri.EscapeDataString(folderPath)}";
            if (!string.IsNullOrEmpty(UploadedBy))
                url += $"&uploadedBy={Uri.EscapeDataString(UploadedBy)}";
            return url;
        }
    }

    // State
    private bool _hasSelectedFiles;
    private bool _isUploading;
    private IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile> _selectedFiles = [];
    private List<string> _successMessages = [];
    private List<string> _errorMessages = [];
    private int _uploadedCount;
    private bool _previousIsVisible;

    protected override async Task OnParametersSetAsync()
    {
        // Handle IsVisible parameter changes
        if (IsVisible != _previousIsVisible)
        {
            _previousIsVisible = IsVisible;

            if (IsVisible)
            {
                await (_dialogBase?.ShowAsync() ?? Task.CompletedTask);
            }
            else
            {
                await (_dialogBase?.CloseAsync() ?? Task.CompletedTask);
            }
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs args)
    {
        _errorMessages.Clear();
        _selectedFiles = args.GetMultipleFiles(20);
        _hasSelectedFiles = _selectedFiles.Any();
        StateHasChanged();
    }

    private async Task StartUpload()
    {
        _successMessages.Clear();
        _errorMessages.Clear();
        _uploadedCount = 0;
        _isUploading = true;
        StateHasChanged();

        foreach (var file in _selectedFiles)
        {
            try
            {
                using var content = new MultipartFormDataContent();
                using var stream = file.OpenReadStream(MaxFileSize);
                var streamContent = new StreamContent(stream);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync(SaveUrl, content);

                if (response.IsSuccessStatusCode)
                {
                    _successMessages.Add($"Successfully uploaded: {file.Name}");
                    _uploadedCount++;
                    Logger.LogInformation("Upload succeeded: {FileName}", file.Name);

                    await BroadcastService.BroadcastFolderContentsChangedAsync(
                        FolderContentsChangedEventArgs.ForAllFolders(FolderChangeType.Upload));
                }
                else
                {
                    _errorMessages.Add($"Failed to upload {file.Name}: {response.ReasonPhrase}");
                    Logger.LogError("Upload failed for {FileName}: {Status}", file.Name, response.ReasonPhrase);
                }
            }
            catch (Exception ex)
            {
                _errorMessages.Add($"Failed to upload {file.Name}: {ex.Message}");
                Logger.LogError(ex, "Upload failed for {FileName}", file.Name);
            }

            StateHasChanged();
        }

        _isUploading = false;
        _hasSelectedFiles = false;
        _selectedFiles = [];
        StateHasChanged();
    }

    private async Task OnClose()
    {
        // Update visibility via two-way binding
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        if (_uploadedCount > 0)
            await OnFilesUploaded.InvokeAsync();

        _hasSelectedFiles = false;
        _isUploading = false;
        _selectedFiles = [];
        _successMessages.Clear();
        _errorMessages.Clear();
        _uploadedCount = 0;
    }
}
