@using Viblog.Admin.Components.Dialogs
@using Viblog.Admin.Services.Dialogs
@inject IDialogService DialogService
@implements IDisposable

<DialogBase @ref="_dialogBase" IsModal="true" CssClass="password-reset-dialog" OnClose="HandleClose">
    <Title>
        @if (!string.IsNullOrWhiteSpace(_dialogInfo?.Title))
        {
            <h2 class="dialog-title">@_dialogInfo.Title</h2>
        }
    </Title>
    <Content>
        @if (_dialogInfo != null)
        {
            <div class="password-reset-content">
                <p class="reset-info">Reset password for <strong>@_dialogInfo.UserName</strong></p>
                
                <EditForm Model="@_model" OnValidSubmit="HandleConfirm">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <TelerikTextBox @bind-Value="@_model.NewPassword"
                                      Id="newPassword"
                                      Password="true"
                                      Placeholder="Enter new password"
                                      Width="100%" />
                        <ValidationMessage For="@(() => _model.NewPassword)" />
                        <small class="form-text text-muted">
                            Must be at least 8 characters with uppercase, lowercase, number, and special character.
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password</label>
                        <TelerikTextBox @bind-Value="@_model.ConfirmPassword"
                                      Id="confirmPassword"
                                      Password="true"
                                      Placeholder="Confirm new password"
                                      Width="100%" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger">
                            @_errorMessage
                        </div>
                    }
                </EditForm>
            </div>
        }
    </Content>
    <ActionButtons>
        <button type="button" class="btn-dialog-cancel" @onclick="HandleCancel">
            Cancel
        </button>
        <button type="button" class="btn-dialog-confirm" @onclick="HandleConfirm" disabled="@_isResetting">
            @if (_isResetting)
            {
                <span>Resetting...</span>
            }
            else
            {
                <span>Reset Password</span>
            }
        </button>
    </ActionButtons>
</DialogBase>

@code {
    private DialogBase? _dialogBase;
    private PasswordResetDialogInfo? _dialogInfo;
    private PasswordResetModel _model = new();
    private string? _errorMessage;
    private bool _isResetting;

    protected override void OnInitialized()
    {
        DialogService.OnDialogChanged += HandleDialogChangedAsync;
    }

    private async Task HandleDialogChangedAsync(DialogInfo? dialog)
    {
        if (dialog is not PasswordResetDialogInfo passwordResetDialog)
        {
            return;
        }

        _dialogInfo = passwordResetDialog;
        _model = new PasswordResetModel();
        _errorMessage = null;
        _isResetting = false;
        StateHasChanged();

        await (_dialogBase?.ShowAsync() ?? Task.CompletedTask);
    }

    private async Task HandleConfirm()
    {
        _errorMessage = null;

        // Validate passwords match
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            StateHasChanged();
            return;
        }

        // Validate password is not empty
        if (string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            _errorMessage = "Password is required.";
            StateHasChanged();
            return;
        }

        _isResetting = true;
        StateHasChanged();

        try
        {
            if (_dialogInfo?.OnConfirmAsync != null)
            {
                await _dialogInfo.OnConfirmAsync.Invoke(_model.NewPassword);
            }

            DialogService.Close();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error resetting password: {ex.Message}";
            _isResetting = false;
            StateHasChanged();
        }
    }

    private void HandleCancel()
    {
        DialogService.Close();
    }

    private void HandleClose()
    {
        DialogService.Close();
    }

    public void Dispose()
    {
        DialogService.OnDialogChanged -= HandleDialogChangedAsync;
    }

    private class PasswordResetModel
    {
        [Required(ErrorMessage = "New password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password confirmation is required")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
