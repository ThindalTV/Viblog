@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<dialog @ref="_dialogElement" class="dialog @CssClass @(IsModal ? "modal" : "non-modal")">
    @if (_shouldRenderContent)
    {
        <div class="dialog-content" @onclick:stopPropagation="true">
            <div class="dialog-header">
                @if (Title != null)
                {
                    <div class="dialog-title-container">
                        @Title
                    </div>
                }
                <button type="button" class="dialog-close" @onclick="HandleClose" @onclick:stopPropagation="true" aria-label="Close">
                    &times;
                </button>
            </div>

            <div class="dialog-body">
                @Content
            </div>

            @if (ActionButtons != null)
            {
                <div class="dialog-actions">
                    @ActionButtons
                </div>
            }
        </div>
    }
</dialog>

@code {
    private ElementReference _dialogElement;
    private bool _isRendered;
    private bool _shouldRenderContent = false;
    private IJSObjectReference? _module;

    /// <summary>
    /// Title content for the dialog
    /// </summary>
    [Parameter]
    public RenderFragment? Title { get; set; }

    /// <summary>
    /// Main content for the dialog
    /// </summary>
    [Parameter]
    public RenderFragment? Content { get; set; }

    /// <summary>
    /// Action buttons for the dialog footer
    /// </summary>
    [Parameter]
    public RenderFragment? ActionButtons { get; set; }

    /// <summary>
    /// Whether the dialog is modal (blocks interaction with page) or non-modal
    /// </summary>
    [Parameter]
    public bool IsModal { get; set; } = true;

    /// <summary>
    /// Additional CSS class to apply to the dialog
    /// </summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    /// <summary>
    /// Callback when the dialog is closed
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isRendered = true;
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/dialogBase.js");
        }
    }

    /// <summary>
    /// Show the dialog
    /// </summary>
    public async Task ShowAsync()
    {
        // Enable content rendering on first show
        if (!_shouldRenderContent)
        {
            _shouldRenderContent = true;
            StateHasChanged();
            await Task.Delay(50); // Allow content to render
        }

        // Wait for render and module load if needed
        if (!_isRendered || _module == null)
        {
            await Task.Delay(50);
        }

        // Guard: Don't attempt JS interop if module isn't loaded
        if (_module == null)
        {
            Console.WriteLine("DialogBase: Cannot show dialog - JS module not loaded");
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("showDialog", _dialogElement, IsModal);
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected - dialog can't be shown but this is not critical
            Console.WriteLine("DialogBase: Circuit disconnected while showing dialog");
        }
        catch (Exception ex)
        {
            // Log other exceptions for debugging
            Console.WriteLine($"DialogBase: Error showing dialog - {ex.GetType().Name}: {ex.Message}");
        }
    }

    /// <summary>
    /// Close the dialog
    /// </summary>
    public async Task CloseAsync()
    {
        // Guard: Don't attempt JS interop if module isn't loaded
        if (_module == null)
        {
            await OnClose.InvokeAsync();
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("closeDialog", _dialogElement);
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected - dialog can't be closed via JS but we continue cleanup
            Console.WriteLine("DialogBase: Circuit disconnected while closing dialog");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DialogBase: Error closing dialog - {ex.GetType().Name}: {ex.Message}");
        }

        await OnClose.InvokeAsync();

        // Note: We keep _shouldRenderContent = true for faster re-opening
        // Content stays in DOM but dialog is hidden
    }

    private async Task HandleClose()
    {
        await CloseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already disconnected - can't dispose JS module but that's okay
                // The browser will clean it up when the page unloads
            }
            catch (Exception ex)
            {
                // Log but don't throw - disposal should never fail
                Console.WriteLine($"DialogBase: Error disposing JS module - {ex.GetType().Name}: {ex.Message}");
            }
        }
    }
}
