@inject IDialogService DialogService
@implements IDisposable

<TelerikDialog @bind-Visible="_visible" Title="@(_dialogInfo?.Title ?? string.Empty)">
    <DialogContent>
        <p>@(_dialogInfo?.Message ?? string.Empty)</p>
    </DialogContent>
    <DialogButtons>
        @if (_dialogInfo?.ShowCancel == true)
        {
            <TelerikButton OnClick="HandleCancel">@_dialogInfo.CancelText</TelerikButton>
        }
        @if (_dialogInfo?.ShowConfirm == true)
        {
            <TelerikButton OnClick="HandleConfirm" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">@_dialogInfo.ConfirmText</TelerikButton>
        }
    </DialogButtons>
</TelerikDialog>

@code {
    private MessageDialogInfo? _dialogInfo;
    private bool _visible;

    protected override void OnInitialized()
    {
        DialogService.OnDialogChanged += HandleDialogChangedAsync;
    }

    private Task HandleDialogChangedAsync(DialogInfo? dialog)
    {
        if (dialog is not MessageDialogInfo messageDialog)
        {
            return Task.CompletedTask;
        }

        _dialogInfo = messageDialog;
        _visible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleConfirm()
    {
        _visible = false;
        if (_dialogInfo?.OnConfirmAsync != null)
        {
            await _dialogInfo.OnConfirmAsync.Invoke();
        }
        else
        {
            _dialogInfo?.OnConfirm?.Invoke();
        }

        DialogService.Close();
    }

    private async Task HandleCancel()
    {
        _visible = false;
        if (_dialogInfo?.OnCancelAsync != null)
        {
            await _dialogInfo.OnCancelAsync.Invoke();
        }
        else
        {
            _dialogInfo?.OnCancel?.Invoke();
        }

        DialogService.Close();
    }

    public void Dispose()
    {
        DialogService.OnDialogChanged -= HandleDialogChangedAsync;
    }
}
