@using Viblog.Admin.Services.Dialogs
@inject IDialogService DialogService
@implements IDisposable

@if (_visible)
{
    <div class="dialog-overlay" @onclick="HandleCancel">
        <div class="dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3>@(_dialogInfo?.Title ?? string.Empty)</h3>
            </div>
            <div class="dialog-content">
                <p>@(_dialogInfo?.Message ?? string.Empty)</p>
            </div>
            <div class="dialog-buttons">
                @if (_dialogInfo?.ShowCancel == true)
                {
                    <button class="btn" @onclick="HandleCancel">@_dialogInfo.CancelText</button>
                }
                @if (_dialogInfo?.ShowConfirm == true)
                {
                    <button class="btn btn-primary" @onclick="HandleConfirm">@_dialogInfo.ConfirmText</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private MessageDialogInfo? _dialogInfo;
    private bool _visible;

    protected override void OnInitialized()
    {
        DialogService.OnDialogChanged += HandleDialogChangedAsync;
    }

    private Task HandleDialogChangedAsync(DialogInfo? dialog)
    {
        if (dialog is not MessageDialogInfo messageDialog)
        {
            return Task.CompletedTask;
        }

        _dialogInfo = messageDialog;
        _visible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleConfirm()
    {
        _visible = false;
        if (_dialogInfo?.OnConfirmAsync != null)
        {
            await _dialogInfo.OnConfirmAsync.Invoke();
        }
        else
        {
            _dialogInfo?.OnConfirm?.Invoke();
        }

        DialogService.Close();
    }

    private async Task HandleCancel()
    {
        _visible = false;
        if (_dialogInfo?.OnCancelAsync != null)
        {
            await _dialogInfo.OnCancelAsync.Invoke();
        }
        else
        {
            _dialogInfo?.OnCancel?.Invoke();
        }

        DialogService.Close();
    }

    public void Dispose()
    {
        DialogService.OnDialogChanged -= HandleDialogChangedAsync;
    }
}
