@using Viblog.Admin.Services.Dialogs
@inject IDialogService DialogService
@implements IDisposable

<DialogBase @ref="_dialogBase" IsModal="true" CssClass="message-dialog" OnClose="HandleCancel">
    <Title>
        @if (!string.IsNullOrWhiteSpace(_dialogInfo?.Title))
        {
            <h3 class="dialog-title">@_dialogInfo.Title</h3>
        }
    </Title>
    <Content>
        @if (!string.IsNullOrWhiteSpace(_dialogInfo?.Message))
        {
            <p>@_dialogInfo.Message</p>
        }
    </Content>
    <ActionButtons>
        @if (_dialogInfo?.ShowCancel == true)
        {
            <button type="button" class="btn-dialog-cancel" @onclick="HandleCancel">@_dialogInfo.CancelText</button>
        }
        @if (_dialogInfo?.ShowConfirm == true)
        {
            <button type="button" class="btn-dialog-confirm" @onclick="HandleConfirm">@_dialogInfo.ConfirmText</button>
        }
    </ActionButtons>
</DialogBase>

@code {
    private DialogBase? _dialogBase;
    private MessageDialogInfo? _dialogInfo;

    protected override void OnInitialized()
    {
        DialogService.OnDialogChanged += HandleDialogChangedAsync;
    }

    private async Task HandleDialogChangedAsync(DialogInfo? dialog)
    {
        if (dialog is not MessageDialogInfo messageDialog)
        {
            await (_dialogBase?.CloseAsync() ?? Task.CompletedTask);
            return;
        }

        _dialogInfo = messageDialog;
        StateHasChanged();
        await (_dialogBase?.ShowAsync() ?? Task.CompletedTask);
    }

    private async Task HandleConfirm()
    {
        if (_dialogInfo?.OnConfirmAsync != null)
        {
            await _dialogInfo.OnConfirmAsync.Invoke();
        }
        else
        {
            _dialogInfo?.OnConfirm?.Invoke();
        }

        DialogService.Close();
    }

    private async Task HandleCancel()
    {
        if (_dialogInfo?.OnCancelAsync != null)
        {
            await _dialogInfo.OnCancelAsync.Invoke();
        }
        else
        {
            _dialogInfo?.OnCancel?.Invoke();
        }

        DialogService.Close();
    }

    public void Dispose()
    {
        DialogService.OnDialogChanged -= HandleDialogChangedAsync;
    }
}
