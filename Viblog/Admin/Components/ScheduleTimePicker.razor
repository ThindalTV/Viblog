@using Viblog.Admin.Components.Dialogs

<DialogBase @ref="_dialogBase" IsModal="true" CssClass="schedule-picker-dialog" OnClose="OnCancelClick">
    <Title>
        <h3 class="dialog-title">@Title</h3>
    </Title>
    <Content>
        <div class="schedule-picker-content">
            <input type="datetime-local"
                   value="@(_selectedDate?.ToString("yyyy-MM-ddTHH:mm"))"
                   min="@_minDate.ToString("yyyy-MM-ddTHH:mm")"
                   @onchange="OnDateChanged"
                   class="form-control" />
            <p class="schedule-picker-note">All times are UTC.</p>
            @if (_selectedDate.HasValue && _selectedDate.Value <= DateTime.UtcNow)
            {
                <p class="schedule-picker-warning">The selected time must be in the future.</p>
            }
        </div>
    </Content>
    <ActionButtons>
        <button type="button" class="btn-dialog-cancel" @onclick="OnCancelClick">Cancel</button>
        <button type="button" class="btn-dialog-confirm" @onclick="OnConfirmClick" disabled="@(!IsConfirmEnabled)">
            Confirm
        </button>
    </ActionButtons>
</DialogBase>

@code {
    private DialogBase? _dialogBase;

    /// <summary>Controls dialog visibility; supports two-way binding.</summary>
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>Dialog title — defaults to "Schedule Publication".</summary>
    [Parameter] public string Title { get; set; } = "Schedule Publication";

    /// <summary>
    /// Pre-populate the picker with an existing date (Change Time flow).
    /// When null, defaults to tomorrow at 09:00 UTC.
    /// </summary>
    [Parameter] public DateTimeOffset? InitialDate { get; set; }

    /// <summary>Raised with the chosen date when the user confirms.</summary>
    [Parameter] public EventCallback<DateTimeOffset> OnConfirm { get; set; }

    /// <summary>Raised when the user cancels without confirming.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private DateTime? _selectedDate;
    private DateTime? _previousInitialDate;
    private readonly DateTime _minDate = DateTime.UtcNow.AddMinutes(1);
    private bool _previousVisible;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible != _previousVisible)
        {
            _previousVisible = Visible;

            if (Visible)
            {
                _selectedDate = InitialDate.HasValue
                    ? InitialDate.Value.UtcDateTime
                    : DateTime.UtcNow.Date.AddDays(1).AddHours(9);

                await (_dialogBase?.ShowAsync() ?? Task.CompletedTask);
            }
            else
            {
                await (_dialogBase?.CloseAsync() ?? Task.CompletedTask);
            }
        }
    }

    private bool IsConfirmEnabled =>
        _selectedDate.HasValue && _selectedDate.Value > DateTime.UtcNow;

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedDate = parsed;
        }
    }

    private async Task OnConfirmClick()
    {
        if (!IsConfirmEnabled || !_selectedDate.HasValue) return;

        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnConfirm.InvokeAsync(new DateTimeOffset(_selectedDate.Value, TimeSpan.Zero));
    }

    private async Task OnCancelClick()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}
