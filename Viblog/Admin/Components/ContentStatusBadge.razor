@using Viblog.Infrastructure.Data.Entities.Content
@using Viblog.Infrastructure.Extensions

@{
    var (cssClass, icon, label) = GetBadgeInfo();
}

<span class="status-badge @cssClass" title="@GetTitle()">
    <span class="status-icon">@((MarkupString)icon)</span>
    @label
</span>

@code {
    /// <summary>The content entity to reflect status for. Null when creating new content.</summary>
    [Parameter] public ISchedulableContent? Content { get; set; }

    private (string cssClass, string icon, string label) GetBadgeInfo()
    {
        if (Content is null)
            return ("status-unsaved", "&#x2B55;", "Unsaved");

        if (Content.IsDeleted)
            return ("status-deleted", "&#x1F5D1;", "Deleted");

        if (Content.IsPublished && Content.HasPendingUpdate && Content.Schedule.ScheduledPublishDate.HasValue)
        {
            var date = Content.Schedule.ScheduledPublishDate.Value.ToString("MMM d, yyyy 'at' HH:mm");
            return ("status-update", "&#x21BB;", $"Published \u00b7 Update {date}");
        }

        if (Content.IsPublished)
        {
            var date = Content.Schedule.PublishedAt.HasValue ? $" \u2014 {Content.Schedule.PublishedAt.Value.ToString("MMM d, yyyy")}" : string.Empty;
            return ("status-published", "&#x2713;", $"Published{date}");
        }

        if (Content.Schedule.Status == ContentStatus.Scheduled && Content.Schedule.ScheduledPublishDate.HasValue)
        {
            var date = Content.Schedule.ScheduledPublishDate.Value.ToString("MMM d, yyyy 'at' HH:mm");
            return ("status-scheduled", "&#x23F0;", $"Scheduled \u2014 {date}");
        }

        return ("status-draft", "&#x270E;", "Draft");
    }

    private string GetTitle()
    {
        if (Content is null) return "Not yet saved.";
        if (Content.IsDeleted)
        if (Content.HasPendingUpdate && Content.Schedule.ScheduledPublishDate.HasValue) return $"Live with a draft update scheduled for {Content.Schedule.ScheduledPublishDate.Value:u}";
        if (Content.IsPublished) return Content.Schedule.PublishedAt.HasValue ? $"Published on {Content.Schedule.PublishedAt.Value:u}" : "Published";
        if (Content.Schedule.Status == ContentStatus.Scheduled && Content.Schedule.ScheduledPublishDate.HasValue) return $"Scheduled for {Content.Schedule.ScheduledPublishDate.Value:u}";
        return "Draft — not publicly visible";
    }
}
