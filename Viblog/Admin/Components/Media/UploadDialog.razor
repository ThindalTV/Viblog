@inject IMediaFacade MediaFacade
@inject ILogger<UploadDialog> Logger

<TelerikDialog @bind-Visible="@Visible"
              Title="Upload Files"
              Width="600px"
              Height="500px">
    <DialogContent>
        <div class="upload-dialog-content">
            @if (_uploadState == UploadState.Selecting)
            {
                <div class="upload-zone @(_isDragging ? "dragging" : "")"
                     @ondrop="@HandleDrop"
                     @ondrop:preventDefault
                     @ondragenter="@HandleDragEnter"
                     @ondragover:preventDefault
                     @ondragleave="@HandleDragLeave">
                    
                    <TelerikSvgIcon Icon="@SvgIcon.Upload" Size="@ThemeConstants.SvgIcon.Size.ExtraLarge" />
                    <h3>Drag and drop files here</h3>
                    <p>or</p>
                    
                    <TelerikFileSelect AllowedExtensions="@_allowedExtensions"
                                     MaxFileSize="@_maxFileSize"
                                     Multiple="true"
                                     OnSelect="@OnFileSelect">
                        <Template>
                            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
                                Browse Files
                            </TelerikButton>
                        </Template>
                    </TelerikFileSelect>
                    
                    <p class="upload-hint">
                        Maximum file size: @FormatFileSize(_maxFileSize)<br />
                        Allowed types: Images, PDFs, Documents
                    </p>
                </div>
            }
            else if (_uploadState == UploadState.Uploading)
            {
                <div class="upload-progress">
                    <h3>Uploading @_selectedFiles.Count file(s)...</h3>
                    
                    <div class="upload-file-list">
                        @foreach (var file in _uploadProgress)
                        {
                            <div class="upload-file-item @(file.IsComplete ? "complete" : "") @(file.HasError ? "error" : "")">
                                <div class="file-info">
                                    <TelerikSvgIcon Icon="@(file.HasError ? SvgIcon.X : file.IsComplete ? SvgIcon.Check : SvgIcon.Clock)" />
                                    <div class="file-details">
                                        <div class="file-name">@file.FileName</div>
                                        <div class="file-size">@FormatFileSize(file.FileSize)</div>
                                    </div>
                                </div>
                                

                                @if (file.HasError)
                                {
                                    <div class="error-message">@file.ErrorMessage</div>
                                }
                            </div>
                        }
                    </div>
                    
                    <div class="overall-progress">
                        <div>@_completedCount of @_selectedFiles.Count files uploaded</div>
                        <TelerikProgressBar Value="@_completedCount" Max="@_selectedFiles.Count" />
                    </div>
                </div>
            }
            else if (_uploadState == UploadState.Complete)
            {
                <div class="upload-complete">
                    <TelerikSvgIcon Icon="@SvgIcon.CheckCircle" Size="@ThemeConstants.SvgIcon.Size.ExtraLarge" />
                    <h3>Upload Complete!</h3>
                    <p>Successfully uploaded @_completedCount file(s)</p>
                    
                    @if (_failedCount > 0)
                    {
                        <div class="upload-errors">
                            <p class="error-summary">@_failedCount file(s) failed to upload</p>
                            @foreach (var file in _uploadProgress.Where(f => f.HasError))
                            {
                                <div class="error-item">
                                    <strong>@file.FileName:</strong> @file.ErrorMessage
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogButtons>
        @if (_uploadState == UploadState.Selecting)
        {
            <TelerikButton OnClick="@OnCancel">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                         OnClick="@StartUpload"
                         Enabled="@_selectedFiles.Any()">
                Upload @(_selectedFiles.Count > 0 ? $"({_selectedFiles.Count})" : "")
            </TelerikButton>
        }
        else if (_uploadState == UploadState.Uploading)
        {
            <TelerikButton OnClick="@CancelUpload" Enabled="@(!_isUploading)">
                Cancel
            </TelerikButton>
        }
        else if (_uploadState == UploadState.Complete)
        {
            <TelerikButton OnClick="@OnClose">Close</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                         OnClick="@UploadMore">
                Upload More Files
            </TelerikButton>
        }
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string FolderPath { get; set; } = "/";

    [Parameter]
    public EventCallback OnUploadComplete { get; set; }

    private enum UploadState
    {
        Selecting,
        Uploading,
        Complete
    }

    private UploadState _uploadState = UploadState.Selecting;
    private List<FileSelectFileInfo> _selectedFiles = new();
    private List<UploadProgressItem> _uploadProgress = new();
    private bool _isDragging;
    private bool _isUploading;
    private int _completedCount;
    private int _failedCount;
    private CancellationTokenSource? _uploadCts;

    // Configuration
    private readonly long _maxFileSize = 100 * 1024 * 1024; // 100 MB
    private readonly List<string> _allowedExtensions = new()
    {
        ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg",
        ".pdf",
        ".doc", ".docx",
        ".xls", ".xlsx",
        ".mp4", ".webm", ".mov",
        ".mp3", ".wav"
    };

    private async Task OnFileSelect(FileSelectEventArgs args)
    {
        _selectedFiles = args.Files.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleDrop(DragEventArgs args)
    {
        _isDragging = false;
        
        // Note: Browser file drop handling requires InputFile component
        // This is a placeholder for the drag-drop UI
        // Actual file handling would need to be implemented with InputFile
        
        await InvokeAsync(StateHasChanged);
    }

    private void HandleDragEnter(DragEventArgs args)
    {
        _isDragging = true;
    }

    private void HandleDragLeave(DragEventArgs args)
    {
        _isDragging = false;
    }

    private async Task StartUpload()
    {
        if (!_selectedFiles.Any()) return;

        _uploadState = UploadState.Uploading;
        _uploadProgress.Clear();
        _completedCount = 0;
        _failedCount = 0;
        _isUploading = true;
        _uploadCts = new CancellationTokenSource();

        // Initialize progress items
        foreach (var file in _selectedFiles)
        {
            _uploadProgress.Add(new UploadProgressItem
            {
                FileName = file.Name,
                FileSize = file.Size,
                Progress = 0
            });
        }

        await InvokeAsync(StateHasChanged);

        try
        {
            // Upload files with limited concurrency
            var uploadTasks = new List<Task>();
            var semaphore = new SemaphoreSlim(3, 3); // Max 3 concurrent uploads

            for (int i = 0; i < _selectedFiles.Count; i++)
            {
                var index = i;
                var file = _selectedFiles[i];
                
                uploadTasks.Add(Task.Run(async () =>
                {
                    await semaphore.WaitAsync(_uploadCts.Token);
                    try
                    {
                        await UploadFileAsync(file, _uploadProgress[index], _uploadCts.Token);
                    }
                    finally
                    {
                        semaphore.Release();
                    }
                }));
            }

            await Task.WhenAll(uploadTasks);
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Upload cancelled by user");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during bulk upload");
        }
        finally
        {
            _isUploading = false;
            _uploadState = UploadState.Complete;
            await InvokeAsync(StateHasChanged);
            
            // Notify parent component
            await OnUploadComplete.InvokeAsync();
        }
    }

    private async Task UploadFileAsync(FileSelectFileInfo file, UploadProgressItem progress, CancellationToken cancellationToken)
    {
        try
        {
            progress.Progress = 25;
            await InvokeAsync(StateHasChanged);

            using var stream = file.Stream;
            
            progress.Progress = 50;
            await InvokeAsync(StateHasChanged);

            var mediaItem = await MediaFacade.UploadAsync(
                file.Name,
                stream,
                GetMimeType(file.Name),
                FolderPath,
                uploadedBy: null, // Set from current user context
                cancellationToken);

            progress.Progress = 100;
            progress.IsComplete = true;
            _completedCount++;
            
            Logger.LogInformation("Successfully uploaded file: {FileName}", file.Name);
        }
        catch (Exception ex)
        {
            progress.HasError = true;
            progress.ErrorMessage = ex.Message;
            _failedCount++;
            
            Logger.LogError(ex, "Failed to upload file: {FileName}", file.Name);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelUpload()
    {
        _uploadCts?.Cancel();
    }

    private async Task OnCancel()
    {
        await CloseDialog();
    }

    private async Task OnClose()
    {
        await CloseDialog();
    }

    private async Task CloseDialog()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        
        // Reset state
        _uploadState = UploadState.Selecting;
        _selectedFiles.Clear();
        _uploadProgress.Clear();
    }

    private void UploadMore()
    {
        _uploadState = UploadState.Selecting;
        _selectedFiles.Clear();
        _uploadProgress.Clear();
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string GetMimeType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".svg" => "image/svg+xml",
            ".pdf" => "application/pdf",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".mp4" => "video/mp4",
            ".webm" => "video/webm",
            ".mov" => "video/quicktime",
            ".mp3" => "audio/mpeg",
            ".wav" => "audio/wav",
            _ => "application/octet-stream"
        };
    }

    private class UploadProgressItem
    {
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public int Progress { get; set; }
        public bool IsComplete { get; set; }
        public bool HasError { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
