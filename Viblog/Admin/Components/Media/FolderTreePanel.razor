@using Viblog.Admin.Components.Media
@using Viblog.Shared.Facades
@inject IMediaFacade MediaFacade
@inject ILogger<FolderTreePanel> Logger

<div class="folder-tree-panel">
    <div class="panel-header">
        <h3>Folders</h3>
    </div>
    <div class="panel-content">
        @if (_folderTreeData != null && _folderTreeData.Any())
        {
            <FolderTreeView FolderTreeData="@_folderTreeData"
                           SelectedFolders="@_selectedFoldersInternal"
                           SelectedFoldersChanged="@OnSelectionChanged"
                           OnFolderClicked="@OnFolderClicked" />
        }
        else
        {
            <p class="empty-message">No folders yet</p>
        }
    </div>
</div>

@code {
    [Parameter]
    public string CurrentFolder { get; set; } = "/";

    [Parameter]
    public EventCallback<string> OnFolderNavigate { get; set; }

    private List<FolderNode>? _folderTreeData;
    private IEnumerable<FolderNode> _selectedFoldersInternal = Enumerable.Empty<FolderNode>();

    protected override async Task OnInitializedAsync()
    {
        await LoadFoldersAsync();
    }

    protected override void OnParametersSet()
    {
        // Update selection when CurrentFolder changes from parent
        if (_folderTreeData != null)
        {
            var selectedFolder = _folderTreeData.FirstOrDefault(f => f.Path == CurrentFolder);
            _selectedFoldersInternal = selectedFolder != null 
                ? new[] { selectedFolder } 
                : Enumerable.Empty<FolderNode>();
        }
    }

    private async Task LoadFoldersAsync()
    {
        try
        {
            var persistedFolders = await MediaFacade.GetAllFolderPathsAsync();
            BuildFolderTree(persistedFolders);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load folder paths");
        }
    }

    private void BuildFolderTree(List<string> persistedFolders)
    {
        var nodes = new List<FolderNode>();

        // Always add root
        nodes.Add(new FolderNode { Path = "/", Name = "Media Library", ParentPath = null, IsUiOnly = false });

        foreach (var folder in persistedFolders.Where(f => f != "/"))
        {
            var parts = folder.Split('/', StringSplitOptions.RemoveEmptyEntries);
            var currentPath = "";
            
            for (int i = 0; i < parts.Length; i++)
            {
                var parentPath = i == 0 ? "/" : currentPath;
                currentPath += "/" + parts[i];

                if (!nodes.Any(n => n.Path == currentPath))
                {
                    nodes.Add(new FolderNode
                    {
                        Path = currentPath,
                        Name = parts[i],
                        ParentPath = parentPath,
                        IsUiOnly = false
                    });
                }
            }
        }

        _folderTreeData = nodes;
    }

    public async Task RefreshFoldersAsync()
    {
        await LoadFoldersAsync();
        StateHasChanged();
    }

    public List<FolderNode>? GetFolderTreeData() => _folderTreeData;

    private async Task OnSelectionChanged(IEnumerable<FolderNode> folders)
    {
        _selectedFoldersInternal = folders;
    }

    private async Task OnFolderClicked(TreeViewItemClickEventArgs args)
    {
        if (args.Item is FolderNode folder)
        {
            // Navigate to this folder by notifying parent
            await OnFolderNavigate.InvokeAsync(folder.Path);
        }
    }
}
