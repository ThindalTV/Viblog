@* Breadcrumb Navigation Component *@

<nav class="breadcrumb">
    <a href="@RootUrl" @onclick="@(() => OnNavigate.InvokeAsync("/"))" @onclick:preventDefault>@RootLabel</a>
    @if (!string.IsNullOrEmpty(CurrentPath) && CurrentPath != "/")
    {
        var parts = CurrentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var path = "";
        foreach (var part in parts)
        {
            path += "/" + part;
            var currentPath = path;
            <span class="separator">/</span>
            <a href="@GetUrl(currentPath)" @onclick="@(() => OnNavigate.InvokeAsync(currentPath))" @onclick:preventDefault>@part</a>
        }
    }
</nav>

@code {
    [Parameter]
    public string CurrentPath { get; set; } = "/";

    [Parameter]
    public string RootLabel { get; set; } = "Home";

    [Parameter]
    public string RootUrl { get; set; } = "/";

    [Parameter]
    public string BaseUrl { get; set; } = "/";

    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    private string GetUrl(string folderPath)
    {
        return $"{BaseUrl}{(folderPath == "/" ? "" : folderPath)}";
    }
}
