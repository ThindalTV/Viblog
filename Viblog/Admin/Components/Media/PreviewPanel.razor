@inject IMediaFacade MediaFacade
@inject NavigationManager NavigationManager
@inject ILogger<PreviewPanel> Logger

@if (PreviewItem != null)
{
    <div class="preview-panel">
        <div class="panel-header">
            <h3>Preview</h3>
            <TelerikButton Icon="@SvgIcon.X"
                         FillMode="@ThemeConstants.Button.FillMode.Flat"
                         OnClick="@OnClose">
            </TelerikButton>
        </div>
        <div class="panel-content">
            <div class="preview-content">
                @if (PreviewItem.MimeType.StartsWith("image/"))
                {
                    <img src="@PreviewItem.PublicUrl" alt="@PreviewItem.AltText" class="preview-image" />
                }
                else if (PreviewItem.MimeType == "application/pdf")
                {
                    <TelerikPdfViewer Url="@PreviewItem.PublicUrl"
                                    Height="100%">
                    </TelerikPdfViewer>
                }
                else if (PreviewItem.MimeType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ||
                         PreviewItem.MimeType == "application/vnd.ms-excel")
                {
                    <p>Excel preview (Telerik Spreadsheet to be configured)</p>
                }
                else if (PreviewItem.MimeType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
                         PreviewItem.MimeType == "application/msword")
                {
                    <p>Word document preview (requires conversion to PDF)</p>
                }
                else
                {
                    var icon = Viblog.Shared.Helpers.MediaIconHelper.GetFileTypeIcon(PreviewItem.MimeType, PreviewItem.FileName);
                    <div class="preview-icon">
                        <img src="@icon" alt="@PreviewItem.FileExtension file" />
                    </div>
                }
            </div>
            <div class="preview-metadata">
                <h4>@PreviewItem.FileName</h4>
                <dl>
                    <dt>Type</dt>
                    <dd>@PreviewItem.MimeType</dd>
                    
                    <dt>Size</dt>
                    <dd>@FormatFileSize(PreviewItem.FileSize)</dd>
                    
                    @if (PreviewItem.Width.HasValue && PreviewItem.Height.HasValue)
                    {
                        <dt>Dimensions</dt>
                        <dd>@PreviewItem.Width × @PreviewItem.Height</dd>
                    }
                    
                    <dt>Uploaded</dt>
                    <dd>@PreviewItem.CreatedAt.ToString("g")</dd>
                    
                    @if (!string.IsNullOrEmpty(PreviewItem.UploadedBy))
                    {
                        <dt>By</dt>
                        <dd>@PreviewItem.UploadedBy</dd>
                    }
                </dl>
            </div>
            <div class="preview-actions">
                <TelerikButton OnClick="@DownloadItem">
                    Download
                </TelerikButton>
                <TelerikButton OnClick="@ShowEditMetadataDialog">
                    Edit Metadata
                </TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                             OnClick="@ShowDeleteDialog">
                    Delete
                </TelerikButton>
            </div>
        </div>
    </div>
}

<DeleteConfirmationDialog Visible="@_showDeleteDialog"
                         VisibleChanged="@((bool v) => _showDeleteDialog = v)"
                         SelectedItems="@_itemsToDelete"
                         OnConfirm="@HandleDeleteConfirmedAsync" />

<EditMetadataDialog Visible="@_showEditMetadataDialog"
                   VisibleChanged="@((bool v) => _showEditMetadataDialog = v)"
                   Item="@PreviewItem"
                   OnMetadataSaved="@HandleMetadataSavedAsync" />

@code {
    [Parameter]
    public MediaItem? PreviewItem { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool _showDeleteDialog;
    private bool _showEditMetadataDialog;
    private List<MediaItem> _itemsToDelete = new();

    private void ShowDeleteDialog()
    {
        if (PreviewItem != null)
        {
            _itemsToDelete = new List<MediaItem> { PreviewItem };
            _showDeleteDialog = true;
        }
    }

    private void ShowEditMetadataDialog()
    {
        _showEditMetadataDialog = true;
    }

    private async Task HandleDeleteConfirmedAsync()
    {
        try
        {
            _showDeleteDialog = false;
            
            if (PreviewItem != null)
            {
                await MediaFacade.BulkDeleteAsync(new List<MediaItem> { PreviewItem });
                Logger.LogInformation("Deleted media item: {FileName}", PreviewItem.FileName);
                
                // Close preview after delete
                await OnClose.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete media item");
        }
    }

    private async Task HandleMetadataSavedAsync(EditMetadataDialog.MediaItemMetadata metadata)
    {
        try
        {
            _showEditMetadataDialog = false;
            
            if (PreviewItem != null && PreviewItem.Id == metadata.Id)
            {
                // Update preview item with new metadata
                PreviewItem.Title = metadata.Title;
                PreviewItem.Description = metadata.Description;
                PreviewItem.AltText = metadata.AltText;
                
                // TODO: Call MediaService.UpdateMetadataAsync when available
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save metadata for item: {Id}", metadata.Id);
        }
    }

    private void DownloadItem()
    {
        try
        {
            if (PreviewItem != null)
            {
                // Navigate to public URL to trigger download
                NavigationManager.NavigateTo(PreviewItem.PublicUrl, forceLoad: true);
                Logger.LogInformation("Download initiated for {FileName}", PreviewItem.FileName);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download item");
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
