<TelerikDialog @bind-Visible="@Visible"
              Title="Edit Metadata"
              Width="600px">
    <DialogContent>
        @if (_editingItem != null)
        {
            <div class="metadata-form">
                <div class="form-group">
                    <label>Title</label>
                    <TelerikTextBox @bind-Value="@_editingItem.Title"
                                  Width="100%"
                                  Placeholder="Enter title..." />
                </div>
                
                <div class="form-group">
                    <label>Description</label>
                    <TelerikTextArea @bind-Value="@_editingItem.Description"
                                   Rows="4"
                                   Width="100%"
                                   Placeholder="Enter description..." />
                </div>
                
                <div class="form-group">
                    <label>Alt Text (for images)</label>
                    <TelerikTextBox @bind-Value="@_editingItem.AltText"
                                  Width="100%"
                                  Placeholder="Enter alt text for accessibility..." />
                </div>
            </div>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@OnCancel">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                     OnClick="@HandleSave">
            Save
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public MediaItem? Item { get; set; }

    [Parameter]
    public EventCallback<MediaItemMetadata> OnMetadataSaved { get; set; }

    private MediaItemMetadata? _editingItem;

    protected override void OnParametersSet()
    {
        if (Visible && Item != null)
        {
            // Create a copy for editing
            _editingItem = new MediaItemMetadata
            {
                Id = Item.Id,
                PartitionKey = Item.PartitionKey,
                Title = Item.Title,
                Description = Item.Description,
                AltText = Item.AltText
            };
        }
    }

    private async Task OnCancel()
    {
        _editingItem = null;
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSave()
    {
        if (_editingItem != null)
        {
            Visible = false;
            await VisibleChanged.InvokeAsync(false);
            await OnMetadataSaved.InvokeAsync(_editingItem);
            _editingItem = null;
        }
    }

    /// <summary>
    /// Simplified metadata model for editing
    /// </summary>
    public class MediaItemMetadata
    {
        public string Id { get; set; } = "";
        public string PartitionKey { get; set; } = "";
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? AltText { get; set; }
    }
}
