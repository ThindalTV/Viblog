@using Viblog.Admin.Components.Media
@inject IMediaFacade MediaFacade
@inject ILogger<MediaGridPanel> Logger

<div class="media-grid-panel">
    <div class="panel-header">
        <div class="panel-header-left">
            <h3>@(_mediaItems?.TotalCount ?? 0) items</h3>
        </div>
        <div class="panel-header-right">
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                         Icon="@SvgIcon.Upload"
                         OnClick="@ShowUploadDialog">
                Upload
            </TelerikButton>
            <TelerikButton Icon="@SvgIcon.FolderAdd"
                         OnClick="@OnNewFolder">
                New Folder
            </TelerikButton>
            <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
                <TelerikButton Icon="@SvgIcon.Grid"
                             Selected="@(_viewMode == "grid")"
                             OnClick="@(() => SetViewMode("grid"))">
                </TelerikButton>
                <TelerikButton Icon="@SvgIcon.ListUnordered"
                             Selected="@(_viewMode == "list")"
                             OnClick="@(() => SetViewMode("list"))">
                </TelerikButton>
            </TelerikButtonGroup>
            <TelerikDropDownList Data="@_sortOptions"
                               @bind-Value="@_selectedSort"
                               OnChange="@OnSortChanged"
                               Width="150px">
            </TelerikDropDownList>
            <TelerikButton Icon="@(_sortAscending ? SvgIcon.SortAscSmall : SvgIcon.SortDescSmall)"
                         OnClick="@ToggleSortDirection">
            </TelerikButton>
        </div>
    </div>
    <div class="panel-content">
        @if (_isLoading)
        {
            <div class="loading-indicator">
                <TelerikLoader />
                <p>Loading media...</p>
            </div>
        }
        else if (_mediaItems?.Items != null && _mediaItems.Items.Any())
        {
            <div class="media-grid @_viewMode">
                @foreach (var item in _mediaItems.Items)
                {
                    <div class="media-item @(IsSelected(item) ? "selected" : "")"
                         @onclick="@(() => OnItemClick(item))"
                         @ondblclick="@(() => OnItemDoubleClick.InvokeAsync(item))"
                         @oncontextmenu="@((args) => HandleContextMenu(args, item))"
                         @oncontextmenu:preventDefault>
                        
                        @if (item.MimeType.StartsWith("image/"))
                        {
                            <div class="media-thumbnail">
                                <img src="@item.PublicUrl" alt="@item.AltText" />
                            </div>
                        }
                        else
                        {
                            var icon = Viblog.Shared.Helpers.MediaIconHelper.GetFileTypeIcon(item.MimeType, item.FileName);
                            <div class="media-thumbnail icon">
                                <img src="@icon" alt="@item.FileExtension file" />
                            </div>
                        }
                        
                        <div class="media-info">
                            <div class="media-name" title="@item.FileName">@item.FileName</div>
                            <div class="media-meta">@FormatFileSize(item.FileSize)</div>
                        </div>
                    </div>
                }
            </div>
            
            @if (_mediaItems.TotalPages > 1)
            {
                <div class="pagination">
                    <TelerikPager Total="@_mediaItems.TotalCount"
                                PageSize="@_pageSize"
                                Page="@_currentPage"
                                PageChanged="@OnPageChanged">
                    </TelerikPager>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <TelerikSvgIcon Icon="@SvgIcon.Image" Size="@ThemeConstants.SvgIcon.Size.ExtraLarge" />
                <h3>No media files</h3>
                <p>Upload files to get started</p>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                             Icon="@SvgIcon.Upload"
                             OnClick="@ShowUploadDialog">
                    Upload Files
                </TelerikButton>
            </div>
        }
    </div>
</div>

<UploadDialog Visible="@_showUploadDialog"
             VisibleChanged="@((bool v) => _showUploadDialog = v)"
             FolderPath="@CurrentFolder"
             OnUploadComplete="@HandleUploadCompleteAsync" />

<MoveToFolderDialog Visible="@_showMoveDialog"
                   VisibleChanged="@((bool v) => _showMoveDialog = v)"
                   SelectedItemsCount="@_selectedItems.Count"
                   FolderTreeData="@FolderTreeData"
                   OnMoveConfirmed="@HandleMoveConfirmedAsync" />

<DeleteConfirmationDialog Visible="@_showDeleteDialog"
                         VisibleChanged="@((bool v) => _showDeleteDialog = v)"
                         SelectedItems="@_selectedItems"
                         OnConfirm="@HandleDeleteConfirmedAsync" />

@* Context Menu *@
<TelerikContextMenu @ref="@_contextMenu"
                   Data="@_contextMenuItems"
                   TextField="@nameof(ContextMenuItem.Text)"
                   IconField="@nameof(ContextMenuItem.Icon)"
                   OnClick="@((ContextMenuItem item) => HandleContextMenuClick(item))">
</TelerikContextMenu>

@code {
    [Parameter]
    public string CurrentFolder { get; set; } = "/";

    [Parameter]
    public List<FolderNode>? FolderTreeData { get; set; }

    [Parameter]
    public EventCallback<MediaItem> OnItemDoubleClick { get; set; }

    [Parameter]
    public EventCallback OnUploadComplete { get; set; }

    [Parameter]
    public EventCallback<(MediaItem Item, string TargetPath)> OnItemMoved { get; set; }

    [Parameter]
    public EventCallback OnNewFolder { get; set; }

    // Internal state
    private PagedResult<MediaItem>? _mediaItems;
    private bool _isLoading = true;
    private string _viewMode = "grid";
    private int _currentPage = 1;
    private int _pageSize = 50;
    private bool _sortAscending = false;
    private string _selectedSort = "Date";
    
    private bool _showUploadDialog;
    private bool _showMoveDialog;
    private bool _showDeleteDialog;
    private List<MediaItem> _selectedItems = new();
    private TelerikContextMenu<ContextMenuItem>? _contextMenu;

    private List<string> _sortOptions = new() { "Name", "Size", "Date", "Type" };
    
    private List<ContextMenuItem> _contextMenuItems = new()
    {
        new ContextMenuItem { Text = "Preview", Icon = SvgIcon.Eye, Action = "preview" },
        new ContextMenuItem { Text = "Download", Icon = SvgIcon.Download, Action = "download" },
        new ContextMenuItem { Text = "Edit Metadata", Icon = SvgIcon.Pencil, Action = "edit" },
        new ContextMenuItem { Text = "Move to Folder", Icon = SvgIcon.FolderAdd, Action = "move" },
        new ContextMenuItem { Text = "Delete", Icon = SvgIcon.Trash, Action = "delete" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadMediaItemsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadMediaItemsAsync();
    }

    private async Task LoadMediaItemsAsync()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var paging = new PagingParameters { PageNumber = _currentPage, PageSize = _pageSize };
            _mediaItems = await MediaFacade.GetMediaItemsAsync(CurrentFolder, null, paging);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load media items for folder: {Folder}", CurrentFolder);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowUploadDialog()
    {
        _showUploadDialog = true;
        StateHasChanged();
    }

    private void SetViewMode(string mode)
    {
        _viewMode = mode;
        StateHasChanged();
    }

    private void OnItemClick(MediaItem item)
    {
        if (_selectedItems.Contains(item))
        {
            _selectedItems.Remove(item);
        }
        else
        {
            _selectedItems.Clear();
            _selectedItems.Add(item);
        }
    }

    private bool IsSelected(MediaItem item)
    {
        return _selectedItems.Contains(item);
    }

    private void HandleContextMenu(MouseEventArgs args, MediaItem item)
    {
        // Ensure the item is selected
        if (!_selectedItems.Contains(item))
        {
            _selectedItems.Clear();
            _selectedItems.Add(item);
        }
        
        // Show context menu at mouse position
        _contextMenu?.ShowAsync(args.ClientX, args.ClientY);
    }

    private async Task HandleContextMenuClick(ContextMenuItem menuItem)
    {
        switch (menuItem.Action)
        {
            case "preview":
                if (_selectedItems.Count == 1)
                {
                    await OnItemDoubleClick.InvokeAsync(_selectedItems.First());
                }
                break;
                
            case "download":
                // Download is handled by preview panel, just trigger preview
                if (_selectedItems.Count == 1)
                {
                    await OnItemDoubleClick.InvokeAsync(_selectedItems.First());
                }
                break;
                
            case "edit":
                if (_selectedItems.Count == 1)
                {
                    // Trigger preview which shows edit dialog
                    await OnItemDoubleClick.InvokeAsync(_selectedItems.First());
                }
                break;
                
            case "move":
                ShowMoveDialog();
                break;
                
            case "delete":
                ShowDeleteDialog();
                break;
        }
    }

    private void ShowMoveDialog()
    {
        if (_selectedItems.Any())
        {
            _showMoveDialog = true;
        }
    }

    private void ShowDeleteDialog()
    {
        if (_selectedItems.Any())
        {
            _showDeleteDialog = true;
        }
    }

    private async Task HandleUploadCompleteAsync()
    {
        _showUploadDialog = false;
        await OnUploadComplete.InvokeAsync();
        await LoadMediaItemsAsync(); // Refresh grid
    }

    private async Task HandleMoveConfirmedAsync(FolderNode targetFolder)
    {
        _showMoveDialog = false;
        
        foreach (var item in _selectedItems)
        {
            await OnItemMoved.InvokeAsync((item, targetFolder.Path));
        }
        
        _selectedItems.Clear();
        await LoadMediaItemsAsync(); // Refresh grid
    }

    private async Task HandleDeleteConfirmedAsync()
    {
        try
        {
            _showDeleteDialog = false;
            
            var deleteCount = await MediaFacade.BulkDeleteAsync(_selectedItems);
            Logger.LogInformation("Deleted {Count} media items", deleteCount);
            
            _selectedItems.Clear();
            await LoadMediaItemsAsync(); // Refresh grid
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete media items");
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        _currentPage = newPage;
        await LoadMediaItemsAsync();
    }

    private async Task OnSortChanged()
    {
        await LoadMediaItemsAsync();
    }

    private async Task ToggleSortDirection()
    {
        _sortAscending = !_sortAscending;
        await LoadMediaItemsAsync();
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
