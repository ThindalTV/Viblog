<div class="card stat-card">
    <Icon Name="@Icon" Class="stat-icon" />
    <div class="stat-value">@Value</div>
    <div class="stat-label">@Label</div>
</div>

@code {
    /// <summary>Material Symbols icon name displayed at the top of the card.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "star";

    /// <summary>Formatted value string shown as the main number.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    /// <summary>Short descriptive label shown below the value.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
}
