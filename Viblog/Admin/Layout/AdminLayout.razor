@inherits LayoutComponentBase
@implements IDisposable
@using Viblog.Admin.Components
@using Viblog.Admin.Services
@inject NavigationManager Navigation

<HeadContent>
    <link rel="stylesheet" href="_content/Telerik.UI.for.Blazor/css/kendo-theme-default/all.css" />
    <link rel="stylesheet" href="@Assets["admin.css"]" />
    <script src="_content/Telerik.UI.for.Blazor/js/telerik-blazor.js"></script>
</HeadContent>

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized Context="authContext">
            <div class="admin-container">
                <aside class="admin-sidebar @(_expanded ? "expanded" : "collapsed")">
                    <div class="sidebar-header">
                        <div class="logo">
                            <TelerikSvgIcon Icon="@SvgIcon.Image" Size="@ThemeConstants.SvgIcon.Size.ExtraLarge" />
                            @if (_expanded)
                            {
                                <span class="logo-text">Viblo<strong>G</strong></span>
                            }
                        </div>
                    </div>

                    <nav class="sidebar-nav">
                        <div class="nav-section">
                            <div class="nav-section-title">@(_expanded ? "Navigation" : "")</div>
                            @foreach (var item in _navigationItems)
                            {
                                <MenuItem Text="@item.Text"
                                         Icon="@item.Icon"
                                         Url="@item.Url"
                                         Expanded="@_expanded" 
                                         IsActive="@IsSelected(item)" />
                            }
                        </div>

                        <div class="nav-section">
                            <div class="nav-section-title">@(_expanded ? "Stats" : "")</div>
                            <div class="stats-widget">
                                <div class="stat-item">
                                    <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
                                    @if (_expanded)
                                    {
                                        <div class="stat-content">
                                            <div class="stat-label">September Earnings</div>
                                            <div class="stat-value">$1158</div>
                                        </div>
                                    }
                                </div>
                                <div class="stat-item">
                                    <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
                                    @if (_expanded)
                                    {
                                        <div class="stat-content">
                                            <div class="stat-label">August Earnings</div>
                                            <div class="stat-value">$1901</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="nav-section nav-section-logout">
                            <MenuItem Text="Logout"
                                     Icon="@SvgIcon.Logout"
                                     Url="/admin/logout"
                                     Expanded="@_expanded" 
                                     IsActive="false" />
                        </div>
                    </nav>
                </aside>

                <div class="admin-main">
                    <header class="admin-header">
                        <div class="header-left">
                            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                                         Icon="@(_expanded ? SvgIcon.ChevronDoubleLeft : SvgIcon.Menu)"
                                         OnClick="@((MouseEventArgs args) => _expanded = !_expanded)">
                            </TelerikButton>
                            <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                                         Icon="@SvgIcon.X">
                            </TelerikButton>
                            <div class="search-box">
                                <TelerikSvgIcon Icon="@SvgIcon.Search" />
                                <input type="text" placeholder="Search..." />
                            </div>
                        </div>
                        
                        <div class="header-right">
                            <div class="user-menu">
                                <span class="user-name">@authContext.User.Identity?.Name</span>
                            </div>
                        </div>
                    </header>

                    <div class="admin-breadcrumb">
                        <a href="/admin">Home</a>
                        <span class="separator">/</span>
                        <span>@GetCurrentPageName()</span>
                    </div>

                    <main class="admin-content">
                        <MessageDisplay />
                        <DialogContainer />
                        @Body
                    </main>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>
<ReconnectModal />

@code {
    private bool _expanded = true;

    private List<DrawerItem> _navigationItems = new()
    {
        new DrawerItem { Text = "Dashboard", Icon = SvgIcon.Grid, Url = "/admin" },
        new DrawerItem { Text = "Posts", Icon = SvgIcon.FileAdd, Url = "/admin/posts" },
        new DrawerItem { Text = "Pages", Icon = SvgIcon.FileData, Url = "/admin/pages" },
        new DrawerItem { Text = "Media", Icon = SvgIcon.Image, Url = "/admin/media" },
        new DrawerItem { Text = "Users", Icon = SvgIcon.User, Url = "/admin/users" },
        new DrawerItem { Text = "Profile", Icon = SvgIcon.User, Url = "/admin/profile" },
        new DrawerItem { Text = "Audit Logs", Icon = SvgIcon.FileReport, Url = "/admin/audit-logs" },
        new DrawerItem { Text = "Analytics", Icon = SvgIcon.ChartLineMarkers, Url = "/admin/analytics" },
        new DrawerItem { Text = "Settings", Icon = SvgIcon.Gear, Url = "/admin/settings" }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool IsSelected(DrawerItem item)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var targetPath = item.Url.TrimStart('/');
        
        // For Media Library, also match subpaths like /admin/media/folder1
        if (item.Url == "/admin/media" && currentPath.StartsWith("admin/media", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        
        return currentPath.Equals(targetPath, StringComparison.OrdinalIgnoreCase);
    }

    private string GetCurrentPageName()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        
        // Check for exact match first
        var item = _navigationItems.FirstOrDefault(i => 
            currentPath.Equals(i.Url.TrimStart('/'), StringComparison.OrdinalIgnoreCase));

        // If no exact match, check if current path starts with any nav item URL
        if (item == null)
        {
            item = _navigationItems.FirstOrDefault(i => 
                currentPath.StartsWith(i.Url.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
        }
        
        return item?.Text ?? "Dashboard";
    }

    private void HandleLogout()
    {
        // Redirect to logout endpoint which will handle Auth0 logout
        Navigation.NavigateTo("/admin/logout", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
