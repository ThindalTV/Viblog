@inherits LayoutComponentBase
@implements IDisposable
@using Viblog.Admin.Components
@using Viblog.Admin.Services
@inject NavigationManager Navigation

<HeadContent>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="/_content/Viblog/admin.css" />
</HeadContent>

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized Context="authContext">
            <div class="admin-container">
                <aside class="admin-sidebar @(_expanded ? "expanded" : "collapsed")">
                    <div class="sidebar-header">
                        <div class="logo">
                            <Icon Name="image" Size="32" />
                            @if (_expanded)
                            {
                                <span class="logo-text">Viblo<strong>G</strong></span>
                            }
                        </div>
                    </div>

                        <nav class="sidebar-nav">
                            <div class="nav-section">
                                <div class="nav-section-title">@(_expanded ? "Navigation" : "")</div>
                                @foreach (var item in _navigationItems)
                                {
                                    <MenuItem Text="@item.Text"
                                              Icon="@item.Icon"
                                              Url="@item.Url"
                                              Expanded="@_expanded"
                                              IsActive="@IsSelected(item)" />
                                }
                            </div>

                            <div class="nav-section">
                                <div class="nav-section-title">@(_expanded ? "Stats" : "")</div>
                                <div class="stats-widget">
                                    <div class="stat-item">
                                        <Icon Name="calendar_month" />
                                        @if (_expanded)
                                        {
                                            <div class="stat-content">
                                                <div class="stat-label">September Earnings</div>
                                                <div class="stat-value">$1158</div>
                                            </div>
                                        }
                                    </div>
                                    <div class="stat-item">
                                        <Icon Name="calendar_month" />
                                        @if (_expanded)
                                        {
                                            <div class="stat-content">
                                                <div class="stat-label">August Earnings</div>
                                                <div class="stat-value">$1901</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="nav-section nav-section-logout">
                                <MenuItem Text="Logout"
                                          Icon="logout"
                                          Url="/viblog/logout"
                                          Expanded="@_expanded"
                                          IsActive="false" />
                            </div>
                        </nav>
                    </aside>

                    <div class="admin-main">
                        <header class="admin-header">
                            <div class="header-left">
                                <button class="btn btn-icon" @onclick="@(() => _expanded = !_expanded)">
                                    <Icon Name="@(_expanded ? "chevron_left" : "menu")" />
                                </button>
                                <button class="btn btn-icon">
                                    <Icon Name="close" />
                                </button>
                                <div class="search-box">
                                    <Icon Name="search" />
                                    <input type="text" placeholder="Search..." />
                                </div>
                            </div>
                        
                            <div class="header-right">
                                <div class="user-menu">
                                    <span class="user-name">@authContext.User.Identity?.Name</span>
                                </div>
                            </div>
                        </header>

                        <div class="admin-breadcrumb">
                            <a href="/viblog">Home</a>
                            <span class="separator">/</span>
                            <span>@GetCurrentPageName()</span>
                        </div>

                        <main class="admin-content">
                            <MessageDisplay />
                            <DialogContainer />
                            @Body
                        </main>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                @Body
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>
    <ReconnectModal />
@code {
    private bool _expanded = true;

    private List<DrawerItem> _navigationItems = new()
    {
        new DrawerItem { Text = "Dashboard", Icon = "dashboard", Url = "/viblog" },
        new DrawerItem { Text = "Posts", Icon = "post_add", Url = "/viblog/posts" },
        new DrawerItem { Text = "Pages", Icon = "description", Url = "/viblog/pages" },
        new DrawerItem { Text = "Media", Icon = "image", Url = "/viblog/media" },
        new DrawerItem { Text = "Users", Icon = "person", Url = "/viblog/users" },
        new DrawerItem { Text = "Profile", Icon = "account_circle", Url = "/viblog/profile" },
        new DrawerItem { Text = "Audit Logs", Icon = "assignment", Url = "/viblog/audit-logs" },
        new DrawerItem { Text = "Analytics", Icon = "analytics", Url = "/viblog/analytics" },
        new DrawerItem { Text = "Settings", Icon = "settings", Url = "/viblog/settings" }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool IsSelected(DrawerItem item)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var targetPath = item.Url.TrimStart('/');
        
        // For Media Library, also match subpaths like /viblog/media/folder1
        if (item.Url == "/viblog/media" && currentPath.StartsWith("viblog/media", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        
        return currentPath.Equals(targetPath, StringComparison.OrdinalIgnoreCase);
    }

    private string GetCurrentPageName()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        
        // Check for exact match first
        var item = _navigationItems.FirstOrDefault(i =>
            currentPath.Equals(i.Url.TrimStart('/'), StringComparison.OrdinalIgnoreCase));

        // If no exact match, check if current path starts with any nav item URL
        if (item == null)
        {
            item = _navigationItems.FirstOrDefault(i =>
                currentPath.StartsWith(i.Url.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
        }
        
        return item?.Text ?? "Dashboard";
    }

    private void HandleLogout()
    {
        // Redirect to logout endpoint which will handle Auth0 logout
        Navigation.NavigateTo("/viblog/logout", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
