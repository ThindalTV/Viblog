@page "/viblog/pages"
@attribute [Authorize(Policy = RequirePageWrite)]
@layout AdminLayout
@using Viblog.Admin.Components
@using Viblog.Infrastructure.Data.Common
@using Viblog.Infrastructure.Facades
@using Microsoft.AspNetCore.Authorization
@using Viblog.Shared.Extensions

@using PageEntity = Viblog.Infrastructure.Data.Entities.Page
@inject IPagesAdminFacade PagesAdminFacade
@inject NavigationManager NavigationManager
@inject ILogger<Pages> Logger

<PageTitle>Pages - Viblog Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Pages</h1>
        <div class="page-actions">
            <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/viblog/pages/new"))">
                <Icon Name="add" /> New Page
            </button>
        </div>
    </div>

    <div class="page-content">
        <div class="card">
            <div class="pages-toolbar">
                <div class="button-group">
                    <button class="btn @(_publishedFilter == null ? "btn-active" : "")" @onclick="@(() => OnFilterChanged(null))">
                        <Icon Name="grid_view" /> All Pages
                    </button>
                    <button class="btn @(_publishedFilter == true ? "btn-active" : "")" @onclick="@(() => OnFilterChanged(true))">
                        <Icon Name="check" /> Published
                    </button>
                    <button class="btn @(_publishedFilter == false ? "btn-active" : "")" @onclick="@(() => OnFilterChanged(false))">
                        <Icon Name="close" /> Unpublished
                    </button>
                </div>
            </div>

            <ViGrid @ref="@_gridRef"
                    TItem="PageEntity"
                    OnRead="@ReadPagesAsync"
                    OnRowClick="@OnRowClick"
                    Pageable="true"
                    PageSize="@_pageSize"
                    Sortable="true"
                    Height="calc(100vh - 300px)">
                <Columns>
                    <Column TItem="PageEntity"
                            Field="@nameof(PageEntity.Slug)"
                            Title="Slug"
                            Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                <div class="slug-cell">
                                    <strong>/@(item?.Slug)</strong>
                                </div>
                            }
                        </Template>
                    </Column>

                    <Column TItem="PageEntity"
                            Field="@nameof(PageEntity.Draft)"
                            Title="Title"
                            Sortable="false">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                @item?.Draft.Title
                            }
                        </Template>
                    </Column>

                    <Column TItem="PageEntity"
                            Field="@nameof(PageEntity.CreatedAt)"
                            Title="Created"
                            Width="180px"
                            Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                var created = item?.CreatedAt.ToString("MMM dd, yyyy HH:mm");
                            }
                            @created
                        </Template>
                    </Column>

                    <Column TItem="PageEntity"
                            Field="@nameof(PageEntity.UpdatedAt)"
                            Title="Last Updated"
                            Width="180px"
                            Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                var updated = item?.UpdatedAt.ToString("MMM dd, yyyy HH:mm");
                            }
                            @updated
                        </Template>
                    </Column>

                    <Column TItem="PageEntity"
                            Field="PublishedAt"
                            Title="Published"
                            Width="180px"
                            Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                if (item?.Schedule.PublishedAt is { } publishedAt)
                                {
                                    @publishedAt.ToString("MMM dd, yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Draft</span>
                                }
                            }
                        </Template>
                    </Column>

                    <Column TItem="PageEntity"
                            Field="@nameof(PageEntity.IsPublished)"
                            Title="Status"
                            Width="260px"
                            Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                if (item != null)
                                {
                                    <div class="status-cell">
                                        <ContentStatusBadge Content="@item" />
                                    </div>
                                }
                            }
                        </Template>
                    </Column>

                    <Column TItem="PageEntity"
                            Field="@nameof(PageEntity.ViewCount)"
                            Title="Views"
                            Width="100px"
                            Sortable="false">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                var viewCount = item?.ViewCount ?? 0;
                            }
                            @if (viewCount > 0)
                            {
                                <span>@viewCount</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </Template>
                    </Column>
                </Columns>
            </ViGrid>
        </div>
    </div>
</div>

@code {
    private ViGrid<PageEntity>? _gridRef;
    private int _pageSize = 20;
    private bool? _publishedFilter = null;

    private async Task ReadPagesAsync(GridReadEventArgs args)
    {
        // Determine sort field and direction from grid state
        var sortDescriptor = args.Request.Sorts.FirstOrDefault();
        var sortField = PageSortField.IsPublished;
        var sortAscending = true;

        if (sortDescriptor != null)
        {
            sortField = sortDescriptor.Member switch
            {
                nameof(PageEntity.Slug) => PageSortField.Slug,
                nameof(PageEntity.CreatedAt) => PageSortField.CreatedAt,
                nameof(PageEntity.UpdatedAt) => PageSortField.UpdatedAt,
                "IsPublished" => PageSortField.IsPublished,
                "PublishedAt" => PageSortField.PublishedAt,
                _ => PageSortField.IsPublished
            };
            sortAscending = sortDescriptor.SortDirection == SortDirection.Ascending;
        }

        // Calculate paging parameters
        var pageNumber = (args.Request.Page - 1);
        var pagingParams = new PagingParameters(args.Request.Page, args.Request.PageSize);

        try
        {
            var result = await PagesAdminFacade.GetPagesAsync(
                pagingParams,
                publishedOnly: _publishedFilter,
                sortField: sortField,
                ascending: sortAscending);

            args.Data = result.Items;
            args.Total = result.TotalCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading pages");
            args.Data = Enumerable.Empty<PageEntity>();
            args.Total = 0;
        }
    }

    private void OnFilterChanged(bool? publishedOnly)
    {
        _publishedFilter = publishedOnly;
        _gridRef?.Rebind();
    }

    private void OnRowClick(GridRowClickEventArgs args)
    {
        var item = args.Item as PageEntity;
        if (item != null)
        {
            NavigationManager.NavigateTo($"/viblog/pages/edit/{item.Id}");
        }
    }
}
