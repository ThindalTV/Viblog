@page "/admin/pages"
@attribute [Authorize(Policy = RequirePageWrite)]
@layout AdminLayout
@using Viblog.Admin.Components
@using Viblog.Infrastructure.Admin.Facades
@using Viblog.Infrastructure.Shared.Data.Common
@using Microsoft.AspNetCore.Authorization
@using Viblog.Shared.Extensions
@using Viblog.Infrastructure.Shared.Extensions

@using PageEntity = Viblog.Infrastructure.Shared.Data.Entities.Page
@inject IPagesAdminFacade PagesAdminFacade
@inject NavigationManager NavigationManager
@inject ILogger<Pages> Logger

<PageTitle>Pages - Viblog Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Pages</h1>
        <div class="page-actions">
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                         Icon="@SvgIcon.Plus"
                         OnClick="@((MouseEventArgs args) => NavigationManager.NavigateTo("/admin/pages/new"))">
                New Page
            </TelerikButton>
        </div>
    </div>

    <div class="page-content">
        <div class="card">
            <div class="pages-toolbar">
                <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
                    <TelerikButton OnClick="@((MouseEventArgs args) => OnFilterChanged(null))"
                                   Icon="@SvgIcon.Grid">
                        All Pages
                    </TelerikButton>
                    <TelerikButton OnClick="@((MouseEventArgs args) => OnFilterChanged(true))"
                                   Icon="@SvgIcon.Check">
                        Published
                    </TelerikButton>
                    <TelerikButton OnClick="@((MouseEventArgs args) => OnFilterChanged(false))"
                                   Icon="@SvgIcon.X">
                        Unpublished
                    </TelerikButton>
                </TelerikButtonGroup>
            </div>

            <TelerikGrid @ref="@_gridRef"
                        TItem="PageEntity"
                        OnRead="@ReadPagesAsync"
                        OnRowClick="@OnRowClick"
                        Pageable="true"
                        PageSize="@_pageSize"
                        Sortable="true"
                        FilterMode="@GridFilterMode.FilterRow"
                        Height="calc(100vh - 300px)">
                <GridColumns>
                    <GridColumn Field="@nameof(PageEntity.Slug)" 
                               Title="Slug" 
                               Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                <div class="slug-cell">
                                    <strong>/@(item?.Slug)</strong>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                    
                    <GridColumn Field="@nameof(PageEntity.Draft)" 
                               Title="Title" 
                               Sortable="false">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                @item?.Draft.Title
                            }
                        </Template>
                    </GridColumn>
                    
                    <GridColumn Field="@nameof(PageEntity.CreatedAt)" 
                               Title="Created" 
                               Width="180px"
                               Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                var created = item?.CreatedAt.ToString("MMM dd, yyyy HH:mm");
                            }
                            @created
                        </Template>
                    </GridColumn>
                    
                    <GridColumn Field="@nameof(PageEntity.UpdatedAt)" 
                               Title="Last Updated" 
                               Width="180px"
                               Sortable="true">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                var updated = item?.UpdatedAt.ToString("MMM dd, yyyy HH:mm");
                            }
                            @updated
                        </Template>
                    </GridColumn>
                    
                    <GridColumn Field="@nameof(PageEntity.Schedule)"
                               Title="Status"
                               Width="260px"
                               Sortable="false">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                if (item != null)
                                {
                                    <div class="status-cell">
                                        <ContentStatusBadge IsPublished="@item.IsPublished"
                                                            HasPendingUpdate="@item.HasPendingUpdate"
                                                            ScheduleStatus="@item.Schedule.Status"
                                                            ScheduledDate="@item.Schedule.ScheduledPublishDate"
                                                            IsDeleted="@item.IsDeleted" />
                                    </div>
                                }
                            }
                        </Template>
                    </GridColumn>
                    
                    <GridColumn Field="@nameof(PageEntity.ViewCount)" 
                               Title="Views" 
                               Width="100px"
                               Sortable="false">
                        <Template>
                            @{
                                var item = context as PageEntity;
                                var viewCount = item?.ViewCount ?? 0;
                            }
                            @if (viewCount > 0)
                            {
                                <span>@viewCount</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        </div>
    </div>
</div>

@code {
    private TelerikGrid<PageEntity>? _gridRef;
    private int _pageSize = 20;
    private bool? _publishedFilter = null;

    private async Task ReadPagesAsync(GridReadEventArgs args)
    {
        // Determine sort field and direction from grid state
        var sortDescriptor = args.Request.Sorts.FirstOrDefault();
        var sortField = PageSortField.Slug;
        var sortAscending = true;

        if (sortDescriptor != null)
        {
            sortField = sortDescriptor.Member switch
            {
                nameof(PageEntity.Slug) => PageSortField.Slug,
                nameof(PageEntity.CreatedAt) => PageSortField.CreatedAt,
                nameof(PageEntity.UpdatedAt) => PageSortField.UpdatedAt,
                "IsPublished" => PageSortField.IsPublished, // Since IsPublished is a method, we can't use nameof
                _ => PageSortField.Slug
            };
            sortAscending = sortDescriptor.SortDirection == Telerik.DataSource.ListSortDirection.Ascending;
        }

        // Calculate paging parameters
        var pageNumber = (args.Request.Page - 1);
        var pagingParams = new PagingParameters(args.Request.Page, args.Request.PageSize);

        try
        {
            var result = await PagesAdminFacade.GetPagesAsync(
                pagingParams,
                publishedOnly: _publishedFilter,
                sortField: sortField,
                ascending: sortAscending);

            args.Data = result.Items;
            args.Total = result.TotalCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading pages");
            args.Data = Enumerable.Empty<PageEntity>();
            args.Total = 0;
        }
    }

    private void OnFilterChanged(bool? publishedOnly)
    {
        _publishedFilter = publishedOnly;
        _gridRef?.Rebind();
    }

    private void OnRowClick(GridRowClickEventArgs args)
    {
        var item = args.Item as PageEntity;
        if (item != null)
        {
            NavigationManager.NavigateTo($"/admin/pages/edit/{item.Id}");
        }
    }
}
