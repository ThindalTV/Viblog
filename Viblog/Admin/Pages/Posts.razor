@page "/viblog/posts"
@using Viblog.Admin.Components
@using Viblog.Admin.Extensions;
@using Viblog.Infrastructure.Data.Common
@using Viblog.Infrastructure.Data.Entities
@using Viblog.Infrastructure.Data.Entities.Content
@using Viblog.Infrastructure.Facades

@attribute [Authorize(Policy = RequirePostWrite)]
@layout AdminLayout
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager

<PageTitle>Posts - Viblog Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Posts</h1>
        <div class="page-actions">
            <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/viblog/posts/new"))">
                <Icon Name="add" /> New Post
            </button>
        </div>
    </div>

    <div class="page-content">
        <div class="card">
            <div class="posts-toolbar">
                <div class="button-group">
                    <button class="btn @(_publishedFilter == null ? "btn-active" : "")" @onclick="@(() => OnFilterChanged(null))">
                        <Icon Name="grid_view" /> All Posts
                    </button>
                    <button class="btn @(_publishedFilter == true ? "btn-active" : "")" @onclick="@(() => OnFilterChanged(true))">
                        <Icon Name="check" /> Published
                    </button>
                    <button class="btn @(_publishedFilter == false ? "btn-active" : "")" @onclick="@(() => OnFilterChanged(false))">
                        <Icon Name="close" /> Unpublished
                    </button>
                </div>
            </div>

            <ViGrid @ref="@_gridRef"
                    TItem="BlogPost"
                    OnRead="@ReadPostsAsync"
                    OnRowClick="@OnRowClick"
                    Pageable="true"
                    PageSize="@_pageSize"
                    Sortable="true"
                    Height="calc(100vh - 300px)"
                    PageChanged="@PageChanged">
                <Columns>
                    <Column TItem="BlogPost"
                            Field="@nameof(BlogPost.IsFeatured)"
                            Title="Featured"
                            Width="100px"
                            Sortable="true">
                        <Template>
                            @{
                                var post = context as BlogPost;
                                if (post?.IsFeatured == true)
                                {
                                    <Icon Name="star" Class="featured-icon" />
                                }
                            }
                        </Template>
                    </Column>

                    <Column TItem="BlogPost"
                            Field="Draft.Title"
                            Title="Title"
                            Sortable="true">
                        <Template>
                            @{
                                var post = context as BlogPost;

                                if (post?.Draft == null)
                                {
                                    <span class="missing-title">[No Title]</span>
                                } else {
                                    @((MarkupString)post.Draft.Title)
                                }
                            }
                        </Template>
                    </Column>

                    <Column TItem="BlogPost"
                            Field="@nameof(BlogPost.Slug)"
                            Title="Slug"
                            Width="200px"
                            Sortable="true" />

                    <Column TItem="BlogPost"
                            Field="@nameof(BlogPost.CreatedAt)"
                            Title="Created"
                            Width="180px"
                            Sortable="true">
                        <Template>
                            @{
                                var post = context as BlogPost;
                                @post?.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            }
                        </Template>
                    </Column>

                    <Column TItem="BlogPost"
                            Field="@nameof(BlogPost.PublishedAt)"
                            Title="Published"
                            Width="180px"
                            Sortable="true">
                        <Template>
                            @{
                                var post = context as BlogPost;
                                if (post?.PublishedAt is { } publishedAt)
                                {
                                    @publishedAt.ToString("MMM dd, yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Draft</span>
                                }
                            }
                        </Template>
                    </Column>

                    <Column TItem="BlogPost"
                            Field="@nameof(BlogPost.IsPublished)"
                            Title="Status"
                            Width="260px"
                            Sortable="true">
                        <Template>
                            @{
                                var post = context as BlogPost;
                                if (post is not null)
                                {
                                    <div class="status-cell">
                                        <ContentStatusBadge Content="@post" />
                                    </div>
                                }
                            }
                        </Template>
                    </Column>
                </Columns>
            </ViGrid>
        </div>
    </div>
</div>

@code {
    private ViGrid<BlogPost>? _gridRef;
    private int _pageSize = 20;
    private bool? _publishedFilter = null;
    private int _skip = 0;

    private async Task ReadPostsAsync(GridReadEventArgs args)
    {
        // Determine sort field and direction from grid state
        var sortDescriptor = args.Request.Sorts.FirstOrDefault();
        var sortField = PostSortField.IsPublished;
        var sortAscending = true;

        if (sortDescriptor != null)
        {
            sortField = sortDescriptor.Member switch
            {
                nameof(BlogPostContent.Title) => PostSortField.Title,
                nameof(BlogPost.Slug) => PostSortField.Slug,
                nameof(BlogPost.PublishedAt) => PostSortField.PublishedAt,
                nameof(BlogPost.IsFeatured) => PostSortField.IsFeatured,
                nameof(BlogPost.IsPublished) => PostSortField.IsPublished,
                nameof(BlogPost.CreatedAt) => PostSortField.CreatedAt,
                _ => PostSortField.IsPublished
            };
            sortAscending = sortDescriptor.SortDirection == SortDirection.Ascending;
        }

        // Calculate page number from request
        var pageNumber = args.Request.Page;
        var pagingParams = new PagingParameters(pageNumber, args.Request.PageSize);

        // Create a new scope for each request to avoid DbContext disposal issues
        await using (var scope = ServiceProvider.CreateAsyncScope())
        {
            var postsFacade = scope.ServiceProvider.GetRequiredService<IPostsAdminFacade>();
            var result = await postsFacade.GetPostsAsync(
                pagingParams,
                _publishedFilter,
                sortField,
                sortAscending);

            args.Data = result.Items;
            args.Total = result.TotalCount;
        }
    }

    private void OnRowClick(GridRowClickEventArgs args)
    {
        var post = args.Item as BlogPost;
        if (post != null)
        {
            NavigationManager.NavigateTo($"/viblog/posts/edit/{post.Id}");
        }
    }

    private async Task PageChanged(int newPage)
    {
        _skip = newPage;
    }

    private void OnFilterChanged(bool? publishedFilter)
    {
        _publishedFilter = publishedFilter;
        _skip = 0;
        _gridRef?.Rebind();
    }
}
