@page "/admin/pages/new"
@page "/admin/pages/edit/{id}"
@attribute [Authorize(Policy = RequirePageWrite)]
@layout AdminLayout
@using Viblog.Admin.Components
@using Viblog.Admin.Components.Input
@using Viblog.Admin.Extensions
@using Viblog.Admin.Models
@using Viblog.Admin.Services
@using Viblog.Infrastructure.Admin.Facades
@using Viblog.Infrastructure.Shared.Data.Entities
@using Viblog.Infrastructure.Shared.Data.Entities.Content
@using Viblog.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IPagesAdminFacade PagesAdminFacade
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITextUtilities TextUtilities
@inject IMessageService MessageService
@inject IDialogService DialogService

<div class="page-header">
    <h1>@(_isEditMode ? "Edit Page" : "Create New Page")</h1>

    @if (!_isLoading)
    {
        <div class="page-actions">
            @if (_isEditMode && _page != null)
            {
                <ContentStatusBadge IsPublished="@_page.IsPublished"
                                    HasPendingUpdate="@_page.HasPendingUpdate"
                                    ScheduleStatus="@_page.Schedule.Status"
                                    ScheduledDate="@_page.Schedule.ScheduledPublishDate"
                                    IsDeleted="@_page.IsDeleted" />
            }

            @if (_page?.IsDeleted != true)
            {
                @if (_isEditMode && _page != null)
                {
                    var isScheduled = _page.Schedule.Status == ContentStatus.Scheduled;

                    @if (_page.Live == null)
                    {
                        <button type="button" class="@GetPublishNowCssClass()" @onclick="HandlePublishNowClickAsync" disabled="@_isSaving">
                            @(_confirmPublishNow ? "Click to confirm" : "Publish Now")
                        </button>
                        @if (!isScheduled)
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowScheduleDialogAsync" disabled="@_isSaving">
                                Schedule
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowChangeTimeDialogAsync" disabled="@_isSaving">
                                Change Time
                            </button>
                            <button type="button" class="btn-action btn-cancel-schedule" @onclick="CancelScheduleAsync" disabled="@_isSaving">
                                Cancel Schedule
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button" class="@GetPublishNowCssClass()" @onclick="HandlePublishNowClickAsync" disabled="@_isSaving">
                            @(_confirmPublishNow ? "Click to confirm" : "Publish Update Now")
                        </button>
                        @if (!isScheduled)
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowScheduleDialogAsync" disabled="@_isSaving">
                                Schedule Update
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowChangeTimeDialogAsync" disabled="@_isSaving">
                                Change Time
                            </button>
                            <button type="button" class="btn-action btn-cancel-schedule" @onclick="CancelScheduleAsync" disabled="@_isSaving">
                                Cancel Schedule
                            </button>
                        }
                        <button type="button" class="btn-action btn-unpublish" @onclick="ShowUnpublishDialogAsync" disabled="@_isSaving">
                            Unpublish
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(_currentUserId) && _page.AuthorId != _currentUserId)
                    {
                        <button type="button" class="btn-action btn-adopt" @onclick="AdoptAsync" disabled="@_isSaving">
                            Adopt
                        </button>
                    }
                }

                <button type="submit" form="edit-page-form" class="btn-primary" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(_isEditMode ? "Update Page" : "Create Page")</span>
                    }
                </button>

                <button type="button" class="btn-secondary" @onclick="Cancel" disabled="@_isSaving">
                    Cancel
                </button>
            }
        </div>
    }
</div>

@if (_page?.IsDeleted == true)
{
    <div class="deleted-banner">
        <p>This page has been deleted and is read-only.</p>
    </div>
}

<ScheduleTimePicker @bind-Visible="_scheduleDialogVisible"
                    Title="@(_page?.Schedule.Status == ContentStatus.Scheduled ? "Change Scheduled Time" : "Schedule Publication")"
                    InitialDate="@_scheduleInitialDate"
                    OnConfirm="OnScheduleConfirmedAsync" />

@if (_isLoading)
{
    <div class="loading">
        <p>Loading...</p>
    </div>
}
else
{
    <EditForm id="edit-page-form" Model="@_model" OnValidSubmit="HandleValidSubmit" class="edit-page-form">
        <DataAnnotationsValidator />
        
        <FormSection Title="Basic Information">
            <div class="form-grid-two">
                <div class="form-column">
                    <TextInput @bind-Value="_model.Draft.Title"
                              OnBlur="@HandleTitleBlur"
                              Label="Title (optional)"
                              Placeholder="Enter page title"
                              ValidationFor="@(() => _model.Draft.Title)" />

                    <TextInput @bind-Value="_model.Slug"
                              Label="Slug"
                              Placeholder="url-friendly-slug (e.g., 'about', 'contact')"
                              Required="true"
                              ValidationFor="@(() => _model.Slug)" />

                    <CheckboxInput @bind-Value="_model.Draft.ShowTitle"
                                   Label="Show title as heading on page" />

                    <TextInput @bind-Value="_model.AuthorName"
                              Label="Author Name"
                              Placeholder="Author name"
                              Required="true"
                              Disabled="@_isEditMode"
                              ValidationFor="@(() => _model.AuthorName)" />
                </div>

                <div class="form-column">
                    <TextInput @bind-Value="_model.Draft.FeaturedImageUrl"
                              Label="Featured Image URL (optional)"
                              Placeholder="https://example.com/image.jpg"
                              ValidationFor="@(() => _model.Draft.FeaturedImageUrl)" />

                    <TextInput @bind-Value="_model.Draft.FeaturedImageAlt"
                              Label="Featured Image Alt Text"
                              Placeholder="Description of the image"
                              ValidationFor="@(() => _model.Draft.FeaturedImageAlt)" />

                    @if (_model.ViewCount > 0)
                    {
                        <div class="info-field">
                            <label>Views</label>
                            <p>@_model.ViewCount</p>
                        </div>
                    }
                </div>
            </div>
        </FormSection>

        <FormSection Title="Content (Draft Version)">
            <MarkdownEditor @bind-Markdown="_model.Draft.Markdown"
                          @bind-RenderedContent="_model.Draft.Content"
                          Label="Page Content"
                          Placeholder="Write your page content in markdown..."
                          Rows="25" />
        </FormSection>

        <FormSection Title="SEO Metadata">
            <div class="form-grid-two">
                <div class="form-column">
                    <TextInput @bind-Value="_model.Draft.MetaDescription"
                              Label="Meta Description"
                              Placeholder="Brief description for search engines (150-160 characters)"
                              Multiline="true"
                              Rows="3"
                              ValidationFor="@(() => _model.Draft.MetaDescription)" />
                </div>

                <div class="form-column">
                    <TextInput @bind-Value="_model.Draft.MetaKeywords"
                              Label="Meta Keywords (optional)"
                              Placeholder="keyword1, keyword2, keyword3"
                              ValidationFor="@(() => _model.Draft.MetaKeywords)" />
                </div>
            </div>
        </FormSection>

        @if (_page?.IsPublished == true && _model.Live != null)
        {
            <FormSection Title="Currently Published Version (Read-Only)">
                <div class="published-info">
                    <p class="info-note">This is what visitors currently see. Your draft changes above will replace this when published.</p>

                    <div class="live-preview">
                        <h3>@_model.Live.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(_model.Live.Content))
                        {
                            <div class="live-content">
                                @((MarkupString)_model.Live.Content)
                            </div>
                        }
                    </div>
                </div>
            </FormSection>
        }

        @if (_isEditMode && !string.IsNullOrWhiteSpace(Id))
        {
            <FormSection Title="Activity History">
                <AuditLogPanel EntityType="EntityType.Page" EntityId="@Id" PageSize="20" />
            </FormSection>
        }
    </EditForm>
}

@code {
private PageModel _model = new();
private Page? _page;
private bool _isLoading = true;
private bool _isSaving;
private bool _isEditMode;
private bool _scheduleDialogVisible;
private DateTimeOffset? _scheduleInitialDate;
private bool _confirmPublishNow;
private string _currentUserId = string.Empty;

[Parameter]
public string? Id { get; set; }

protected override async Task OnInitializedAsync()
{
    _isEditMode = !string.IsNullOrWhiteSpace(Id);

    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

    if (_isEditMode)
    {
        await LoadPageAsync();
    }
    else
    {
        var userName = authState.User.Identity?.Name ?? "Anonymous";
        _model = new PageModel { AuthorName = userName };
        _isLoading = false;
    }
}

private async Task LoadPageAsync()
{
    try
    {
        _isLoading = true;
        MessageService.Clear();
        _confirmPublishNow = false;

        var page = await PagesAdminFacade.GetPageByIdAsync(Id!);

        if (page == null)
        {
            MessageService.SetFail("Page not found.");
            return;
        }

        _page = page;
        _model = page.ToModel();
    }
    catch (Exception ex)
    {
        MessageService.SetError(ex, "Failed to load page. Please try again.");
    }
    finally
    {
        _isLoading = false;
    }
}

    private void HandleTitleBlur(FocusEventArgs e)
    {
        // Auto-generate slug if it's empty when title loses focus
        if (string.IsNullOrWhiteSpace(_model.Slug))
        {
            _model.Slug = TextUtilities.Slugify(_model.Draft.Title) ?? string.Empty;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (_page?.IsDeleted == true) return;

        try
        {
            _isSaving = true;
            _confirmPublishNow = false;
            MessageService.Clear();

            if (_isEditMode && _page != null)
            {
                // Update only the draft fields; leave Live, Schedule, etc. intact
                _page.Draft.Title = _model.Draft.Title;
                _page.Draft.Markdown = _model.Draft.Markdown;
                _page.Draft.Content = _model.Draft.Content ?? string.Empty;
                _page.Draft.ShowTitle = _model.Draft.ShowTitle;
                _page.Draft.FeaturedImageUrl = _model.Draft.FeaturedImageUrl;
                _page.Draft.FeaturedImageAlt = _model.Draft.FeaturedImageAlt;
                _page.Draft.MetaDescription = _model.Draft.MetaDescription;
                _page.Draft.MetaKeywords = _model.Draft.MetaKeywords;
                _page.Slug = _model.Slug;
                _page.UpdatedAt = DateTimeOffset.UtcNow;

                await PagesAdminFacade.UpdatePageAsync(_page);
                MessageService.SetSuccess("Page saved successfully!");
                await LoadPageAsync();
            }
            else
            {
                var page = _model.ToEntity();
                await PagesAdminFacade.CreatePageAsync(page);
                MessageService.SetSuccess("Page created successfully!");
                Navigation.NavigateTo($"/admin/pages/edit/{page.Id}");
            }
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to save page. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/admin/pages");

    // Publish Now — two-step inline confirmation
    private async Task HandlePublishNowClickAsync()
    {
        if (!_confirmPublishNow)
        {
            _confirmPublishNow = true;
            return;
        }

        _confirmPublishNow = false;
        await ExecutePublishNowAsync();
    }

    private async Task ExecutePublishNowAsync()
    {
        try
        {
            _isSaving = true;
            StateHasChanged();
            await PagesAdminFacade.PublishPageNowAsync(Id!);
            MessageService.SetSuccess(_page?.Live == null ? "Page published successfully!" : "Draft update published successfully!");
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to publish page. Please try again.");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    // Schedule / Change Time
    private Task ShowScheduleDialogAsync()
    {
        _confirmPublishNow = false;
        _scheduleInitialDate = null;
        _scheduleDialogVisible = true;
        return Task.CompletedTask;
    }

    private Task ShowChangeTimeDialogAsync()
    {
        _confirmPublishNow = false;
        _scheduleInitialDate = _page?.Schedule.ScheduledPublishDate;
        _scheduleDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task OnScheduleConfirmedAsync(DateTimeOffset date)
    {
        try
        {
            _isSaving = true;
            await PagesAdminFacade.SchedulePagePublishingAsync(Id!, date);
            MessageService.SetSuccess($"Page scheduled for {date:MMM d, yyyy 'at' HH:mm} UTC.");
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to schedule page. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Cancel Schedule
    private async Task CancelScheduleAsync()
    {
        _confirmPublishNow = false;
        try
        {
            _isSaving = true;
            await PagesAdminFacade.CancelPageScheduleAsync(Id!);
            MessageService.SetSuccess("Schedule cancelled.");
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to cancel schedule. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Unpublish — modal confirmation
    private void ShowUnpublishDialogAsync()
    {
        _confirmPublishNow = false;
        DialogService.ShowConfirmationAsync(
            "Unpublish Page",
            "This will remove the page from public view. Your draft will be preserved. Are you sure?",
            ConfirmUnpublishAsync,
            "Unpublish",
            "Cancel");
    }

    private async Task ConfirmUnpublishAsync()
    {
        try
        {
            _isSaving = true;
            await InvokeAsync(StateHasChanged);
            await PagesAdminFacade.UnpublishPageAsync(Id!);
            MessageService.SetSuccess("Page unpublished successfully.");
            await LoadPageAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to unpublish page. Please try again.");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Adopt
    private async Task AdoptAsync()
    {
        _confirmPublishNow = false;
        try
        {
            _isSaving = true;
            await PagesAdminFacade.AdoptPageAsync(Id!);
            MessageService.SetSuccess("Page ownership transferred to you.");
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to adopt page. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string GetPublishNowCssClass() =>
        _confirmPublishNow ? "btn-action btn-publish-now btn-confirm-active" : "btn-action btn-publish-now";
}

