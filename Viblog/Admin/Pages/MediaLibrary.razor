@page "/admin/media"
@attribute [Authorize(Policy = Admin)]
@layout AdminLayout
@using Viblog.Admin.Layout
@using Viblog.Admin.Components.MediaLibrary
@using Viblog.Admin.Services
@inject IMediaLibraryBroadcastService BroadcastService
@inject ILogger<MediaLibrary> Logger

<PageTitle>Media Library - Viblog Admin</PageTitle>

<div class="media-library">
    <div class="media-library-header">
        <h1>Media Library</h1>
        <button class="btn-primary upload-btn" @onclick="ShowUploadDialog">
            <span class="icon">+</span> Upload Files
        </button>
    </div>

    <MediaLibraryContent />
</div>

<!-- Upload Dialog -->
<MediaUploadDialog @bind-IsVisible="_showUploadDialog"
                  OnFilesUploaded="OnFilesUploadedAsync"
                  UploadedBy="system" />

@code {
    private bool _showUploadDialog;

    private void ShowUploadDialog()
    {
        _showUploadDialog = true;
    }

    private async Task OnFilesUploadedAsync()
    {
        Logger.LogInformation("Files uploaded successfully - broadcasting to all users");
        
        // Broadcast to all users that new files were uploaded
        // Use null for folder/type since uploads can go to various folders based on date
        await BroadcastService.BroadcastFolderContentsChangedAsync(
            FolderContentsChangedEventArgs.ForAllFolders(FolderChangeType.Upload));
        
        _showUploadDialog = false;
    }
}
