@page "/admin/media"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using Viblog.Admin.Layout
@using Viblog.Admin.Models
@using Viblog.Infrastructure.Shared.Data.Common
@using Viblog.Infrastructure.Shared.Data.Entities
@using Viblog.Infrastructure.Shared.Helpers
@using Viblog.Infrastructure.Shared.Services
@inject IMediaService MediaService
@inject ILogger<MediaLibrary> Logger

<PageTitle>Media Library - Viblog Admin</PageTitle>

<div class="media-library">
    <div class="media-library-header">
        <h1>Media Library</h1>
        
        <!-- File Type Filter -->
        <div class="filter-section">
            <label>File Type:</label>
            <select @bind="_viewModel.SelectedMediaType" @bind:after="OnFilterChangedAsync">
                <option value="">All Files</option>
                @foreach (var type in Enum.GetValues<MediaTypeCategory>())
                {
                    <option value="@type">@MediaTypeHelper.GetDisplayName(type)</option>
                }
            </select>
        </div>

        <!-- Search -->
        <div class="search-section">
            <input type="text" 
                   placeholder="Search files..." 
                   @bind="_viewModel.SearchTerm" 
                   @bind:after="OnSearchChangedAsync" />
        </div>

        <!-- Upload Button -->
        <div class="upload-section">
            <button class="btn-primary" @onclick="ShowUploadDialog">
                <span class="icon">+</span> Upload Files
            </button>
        </div>
    </div>

    <div class="media-library-content">
        <!-- Date Folders Sidebar -->
        <div class="date-folders-sidebar">
            <h3>Uploads By Date</h3>
            @if (_viewModel.IsLoading && !_viewModel.DateFolders.Any())
            {
                <p>Loading...</p>
            }
            else if (!_viewModel.DateFolders.Any())
            {
                <p class="no-folders">No uploads yet</p>
            }
            else
            {
                <ul class="date-folder-list">
                    @foreach (var folder in _viewModel.DateFolders)
                    {
                        <li class="@(folder.DateFolder == _viewModel.SelectedDateFolder ? "active" : "")"
                            @onclick="() => SelectDateFolderAsync(folder.DateFolder)">
                            <span class="folder-name">@folder.DisplayName</span>
                            <span class="item-count">@folder.ItemCount</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Media Grid -->
        <div class="media-grid-container">
            @if (_viewModel.IsLoading)
            {
                <div class="loading-overlay">
                    <p>Loading...</p>
                </div>
            }
            else if (!_viewModel.MediaItems.Any())
            {
                <div class="empty-state">
                    <p>No media files found</p>
                    @if (!string.IsNullOrWhiteSpace(_viewModel.SearchTerm))
                    {
                        <p>Try a different search term</p>
                    }
                    else if (_viewModel.SelectedMediaType.HasValue)
                    {
                        <p>Try selecting a different file type</p>
                    }
                    else
                    {
                        <button class="btn-primary" @onclick="ShowUploadDialog">Upload Your First File</button>
                    }
                </div>
            }
            else
            {
                <div class="media-grid">
                    @foreach (var item in _viewModel.MediaItems)
                    {
                        <div class="media-item" @onclick="() => SelectItem(item)">
                            <div class="media-thumbnail">
                                @if (item.PreviewUrl != null)
                                {
                                    <img src="@item.PreviewUrl" alt="@item.AltText" loading="lazy" />
                                }
                                else
                                {
                                    <div class="no-preview">
                                        <span>@Path.GetExtension(item.FileName)</span>
                                    </div>
                                }
                            </div>
                            <div class="media-info">
                                <div class="media-filename" title="@item.FileName">@item.FileName</div>
                                <div class="media-meta">
                                    <span class="file-size">@FormatFileSize(item.FileSize)</span>
                                    <span class="upload-date">@item.CreatedAt.ToString("MMM d, yyyy")</span>
                                </div>
                            </div>
                            @if (_viewModel.SelectedItem?.Id == item.Id)
                            {
                                <div class="selected-indicator"></div>
                            }
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (_viewModel.TotalCount > _viewModel.PageSize)
                {
                    <div class="pagination">
                        <button class="btn-secondary" 
                                disabled="@(_viewModel.CurrentPage <= 1)"
                                @onclick="PreviousPageAsync">
                            Previous
                        </button>
                        
                        <span class="page-info">
                            Page @_viewModel.CurrentPage of @Math.Ceiling((double)_viewModel.TotalCount / _viewModel.PageSize)
                        </span>
                        
                        <button class="btn-secondary" 
                                disabled="@(_viewModel.CurrentPage >= Math.Ceiling((double)_viewModel.TotalCount / _viewModel.PageSize))"
                                @onclick="NextPageAsync">
                            Next
                        </button>
                    </div>
                }
            }
        </div>

        <!-- Preview/Details Panel -->
        @if (_viewModel.SelectedItem != null)
        {
            <div class="details-panel">
                <div class="details-header">
                    <h3>File Details</h3>
                    <button class="btn-close" @onclick="CloseDetails">×</button>
                </div>
                
                <div class="details-content">
                    <div class="details-preview">
                        @if (_viewModel.SelectedItem.PreviewUrl != null)
                        {
                            <img src="@_viewModel.SelectedItem.PublicUrl" alt="@_viewModel.SelectedItem.AltText" />
                        }
                    </div>
                    
                    <div class="details-info">
                        <div class="info-row">
                            <label>Filename:</label>
                            <span>@_viewModel.SelectedItem.FileName</span>
                        </div>
                        <div class="info-row">
                            <label>Size:</label>
                            <span>@FormatFileSize(_viewModel.SelectedItem.FileSize)</span>
                        </div>
                        <div class="info-row">
                            <label>Type:</label>
                            <span>@_viewModel.SelectedItem.MimeType</span>
                        </div>
                        <div class="info-row">
                            <label>Uploaded:</label>
                            <span>@_viewModel.SelectedItem.CreatedAt.ToString("MMMM d, yyyy h:mm tt")</span>
                        </div>
                        @if (_viewModel.SelectedItem.Width.HasValue && _viewModel.SelectedItem.Height.HasValue)
                        {
                            <div class="info-row">
                                <label>Dimensions:</label>
                                <span>@_viewModel.SelectedItem.Width × @_viewModel.SelectedItem.Height</span>
                            </div>
                        }
                        <div class="info-row">
                            <label>URL:</label>
                            <input type="text" readonly value="@_viewModel.SelectedItem.PublicUrl" 
                                   @onclick="() => CopyToClipboard(_viewModel.SelectedItem.PublicUrl)" />
                        </div>
                    </div>
                    
                    <div class="details-actions">
                        <button class="btn-primary" @onclick="() => CopyToClipboard(_viewModel.SelectedItem.PublicUrl)">
                            Copy URL
                        </button>
                        <button class="btn-danger" @onclick="DeleteSelectedItemAsync">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly MediaLibraryViewModel _viewModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDateFoldersAsync();
        await LoadMediaItemsAsync();
    }

    private async Task LoadDateFoldersAsync()
    {
        try
        {
            _viewModel.IsLoading = true;
            var dateFolders = await MediaService.GetDateFoldersAsync(
                _viewModel.SelectedMediaType, 
                CancellationToken.None);

            _viewModel.DateFolders = dateFolders.Select(df => new DateFolderInfo
            {
                DateFolder = df,
                DisplayName = DateFolderInfo.GetDisplayName(df),
                ItemCount = 0 // We could get counts in a separate query if needed
            }).ToList();

            // Auto-select the first (newest) folder if none selected
            if (_viewModel.SelectedDateFolder == null && _viewModel.DateFolders.Any())
            {
                _viewModel.SelectedDateFolder = _viewModel.DateFolders.First().DateFolder;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load date folders");
        }
        finally
        {
            _viewModel.IsLoading = false;
        }
    }

    private async Task LoadMediaItemsAsync()
    {
        try
        {
            _viewModel.IsLoading = true;
            
            var pagingParams = new PagingParameters
            {
                PageNumber = _viewModel.CurrentPage,
                PageSize = _viewModel.PageSize
            };

            PagedResult<MediaItem> result;

            if (!string.IsNullOrWhiteSpace(_viewModel.SearchTerm))
            {
                // Search mode
                result = await MediaService.SearchAsync(
                    _viewModel.SearchTerm,
                    pagingParams,
                    CancellationToken.None);
            }
            else if (_viewModel.SelectedDateFolder != null)
            {
                // Date folder mode
                result = await MediaService.GetItemsByDateFolderAsync(
                    _viewModel.SelectedDateFolder,
                    _viewModel.SelectedMediaType,
                    pagingParams,
                    CancellationToken.None);
            }
            else
            {
                // No items to show
                result = new PagedResult<MediaItem>
                {
                    Items = [],
                    TotalCount = 0,
                    PageNumber = 1,
                    PageSize = _viewModel.PageSize
                };
            }

            _viewModel.MediaItems = result.Items.ToList();
            _viewModel.TotalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load media items");
        }
        finally
        {
            _viewModel.IsLoading = false;
        }
    }

    private async Task OnFilterChangedAsync()
    {
        _viewModel.CurrentPage = 1;
        _viewModel.SelectedDateFolder = null;
        await LoadDateFoldersAsync();
        await LoadMediaItemsAsync();
    }

    private async Task OnSearchChangedAsync()
    {
        _viewModel.CurrentPage = 1;
        await LoadMediaItemsAsync();
    }

    private async Task SelectDateFolderAsync(string dateFolder)
    {
        if (_viewModel.SelectedDateFolder == dateFolder)
            return;

        _viewModel.SelectedDateFolder = dateFolder;
        _viewModel.CurrentPage = 1;
        _viewModel.SearchTerm = null;
        await LoadMediaItemsAsync();
    }

    private void SelectItem(MediaItem item)
    {
        _viewModel.SelectedItem = item;
    }

    private void CloseDetails()
    {
        _viewModel.SelectedItem = null;
    }

    private async Task PreviousPageAsync()
    {
        if (_viewModel.CurrentPage > 1)
        {
            _viewModel.CurrentPage--;
            await LoadMediaItemsAsync();
        }
    }

    private async Task NextPageAsync()
    {
        var maxPage = (int)Math.Ceiling((double)_viewModel.TotalCount / _viewModel.PageSize);
        if (_viewModel.CurrentPage < maxPage)
        {
            _viewModel.CurrentPage++;
            await LoadMediaItemsAsync();
        }
    }

    private void ShowUploadDialog()
    {
        // TODO: Implement upload dialog
        Logger.LogInformation("Upload dialog requested");
    }

    private async Task DeleteSelectedItemAsync()
    {
        if (_viewModel.SelectedItem == null)
            return;

        try
        {
            var success = await MediaService.DeleteAsync(
                _viewModel.SelectedItem.Id,
                _viewModel.SelectedItem.GroupKey,
                CancellationToken.None);

            if (success)
            {
                _viewModel.SelectedItem = null;
                await LoadDateFoldersAsync();
                await LoadMediaItemsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete media item");
        }
    }

    private void CopyToClipboard(string text)
    {
        // TODO: Implement clipboard copy with JavaScript interop
        Logger.LogInformation("Copy to clipboard: {Text}", text);
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
