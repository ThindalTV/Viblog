@page "/viblog/media"
@attribute [Authorize(Policy = Admin)]
@layout AdminLayout
@using Viblog.Admin.Layout
@using Viblog.Admin.Components.MediaLibrary
@inject ILogger<MediaLibrary> Logger

<PageTitle>Media Library - Viblog Admin</PageTitle>

<div class="media-library">
    <div class="media-library-header">
        <h1>Media Library</h1>
        <button class="btn-primary upload-btn" @onclick="ShowUploadDialog">
            <span class="icon">+</span> Upload Files
        </button>
    </div>

    <MediaLibraryContent />
</div>

<!-- Upload Dialog -->
<MediaUploadDialog @bind-IsVisible="_showUploadDialog"
                  OnFilesUploaded="OnFilesUploadedAsync"
                  UploadedBy="system" />

@code {
    private bool _showUploadDialog;

    private void ShowUploadDialog()
    {
        _showUploadDialog = true;
    }

    private void OnFilesUploadedAsync()
    {
        // The dialog broadcasts to the media browser after each file upload.
        // This callback only needs to close the dialog.
        _showUploadDialog = false;
    }
}
