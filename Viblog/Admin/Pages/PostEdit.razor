@page "/admin/posts/new"
@page "/admin/posts/edit/{id}"
@attribute [Authorize(Policy = RequirePostWrite)]
@using Viblog.Admin.Components
@using Viblog.Admin.Components.Input
@using Viblog.Admin.Extensions
@using Viblog.Admin.Models
@using Viblog.Admin.Services
@using Viblog.Frontend.Infrastructure
@using Viblog.Infrastructure.Admin.Facades
@using Viblog.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IPostsAdminFacade PostsAdminFacade
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITextUtilities TextUtilities
@inject IMessageService MessageService
@inject IDialogService DialogService

<div class="page-header">
    <h1>@(_isEditMode ? "Edit Post" : "Create New Post")</h1>
    
    @if (!_isLoading)
    {
        <div class="page-actions">
            @if (!string.IsNullOrWhiteSpace(Id))
            {
                <div class="publication-status">
                    @if (!_model.IsPublished)
                    {
                        <span class="status-badge status-draft">Draft</span>
                    }
                    else if (_model.PublishedAt > DateTimeOffset.UtcNow)
                    {
                        <span class="status-badge status-scheduled">Scheduled</span>
                    }
                    else
                    {
                        <span class="status-badge status-published">Published</span>
                    }
                </div>
            }
            
            @if (!_model.IsPublished || _model.PublishedAt > DateTimeOffset.UtcNow)
            {
                <button type="button" class="btn-action btn-publish-now" @onclick="ShowPublishNowDialog" disabled="@_isSaving">
                    Publish Now
                </button>
                <button type="button" class="btn-action btn-publish-later" @onclick="ShowPublishLaterDialog" disabled="@_isSaving">
                    Schedule
                </button>
            }
            
            @if (_model.IsPublished)
            {
                <button type="button" class="btn-action btn-unpublish" @onclick="ShowUnpublishDialog" disabled="@_isSaving">
                    Unpublish
                </button>
            }
            
            <button type="submit" form="edit-post-form" class="btn-primary" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>@(_isEditMode ? "Update Post" : "Create Post")</span>
                }
            </button>
            
            <button type="button" class="btn-secondary" @onclick="Cancel" disabled="@_isSaving">
                Cancel
            </button>
        </div>
    }
</div>

@if (_isLoading)
{
    <div class="loading">
        <p>Loading...</p>
    </div>
}
else
{
    <EditForm id="edit-post-form" Model="@_model" OnValidSubmit="HandleValidSubmit" class="edit-post-form">
        <DataAnnotationsValidator />
        
        <FormSection Title="Basic Information & Publishing">
            <div class="form-grid-three">
                <div class="form-column">
                    <TextInput @bind-Value="_model.Title"
                              OnBlur="@HandleTitleBlur"
                              Label="Title"
                              Placeholder="Enter post title"
                              Required="true"
                              ValidationFor="@(() => _model.Title)" />

                    <TextInput @bind-Value="_model.Slug"
                              Label="Slug"
                              Placeholder="url-friendly-slug"
                              Required="true"
                              ValidationFor="@(() => _model.Slug)" />

                    <TextInput @bind-Value="_model.Short"
                              Label="Summary"
                              Placeholder="Brief summary of the post"
                              Multiline="true"
                              Rows="3"
                              ValidationFor="@(() => _model.Short)" />
                </div>

                <div class="form-column">
                    <DateTimeInput @bind-Value="_model.PublishedAt"
                                   Label="Published At"
                                   ValidationFor="@(() => _model.PublishedAt)" />

                    <CheckboxInput @bind-Value="_model.IsFeatured"
                                 Label="Featured Post" />

                    <TagInput @bind-Tags="_model.Tags"
                              Label="Tags"
                              HelpText="Press Enter to add a tag" />
                </div>

                <div class="form-column">
                    <TextInput @bind-Value="_model.AuthorName"
                              Label="Author Name"
                              Placeholder="Author name"
                              Required="true"
                              Disabled="@_isEditMode"
                              ValidationFor="@(() => _model.AuthorName)" />

                    <TextInput @bind-Value="_model.FeaturedImageUrl"
                              Label="Featured Image URL (optional)"
                              Placeholder="https://example.com/image.jpg"
                              ValidationFor="@(() => _model.FeaturedImageUrl)" />

                    <TextInput @bind-Value="_model.FeaturedImageAlt"
                              Label="Featured Image Alt Text"
                              Placeholder="Description of the image"
                              ValidationFor="@(() => _model.FeaturedImageAlt)" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Content">
            <MarkdownEditor @bind-Markdown="_model.Markdown"
                          @bind-RenderedContent="_model.Content"
                          Label="Post Content (optional for 'short' posts)"
                          Placeholder="Write your post content in markdown..."
                          Rows="20" />
        </FormSection>
    </EditForm>
}

@code {
    private BlogPostModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditMode;

    [Parameter]
    public string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _isEditMode = !string.IsNullOrWhiteSpace(Id);
        
        if (_isEditMode)
        {
            await LoadPostAsync();
        }
        else
        {
            // Get current user for new posts
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "Anonymous";

            // Initialize with defaults for new post
            _model = new BlogPostModel
            {
                PublishedAt = DateTimeOffset.Now,
                AuthorName = userName
            };
            _isLoading = false;
        }
    }

    private async Task LoadPostAsync()
    {
        try
        {
            _isLoading = true;
            MessageService.Clear();

            // Get post by ID (admin scenario)
            var post = await PostsAdminFacade.GetPostByIdAsync(Id!);

            if (post == null)
            {
                MessageService.SetFail("Post not found.");
                return;
            }

            _model = post.ToModel();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to load post. Please try again.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleTitleBlur(FocusEventArgs e)
    {
        // Auto-generate slug if it's empty when title loses focus
        if (string.IsNullOrWhiteSpace(_model.Slug))
        {
            _model.Slug = TextUtilities.Slugify(_model.Title) ?? string.Empty;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            _isSaving = true;
            MessageService.Clear();

            var post = _model.ToEntity();

            if (_isEditMode)
            {
                post.UpdatedAt = DateTimeOffset.UtcNow;
                await PostsAdminFacade.UpdatePostAsync(post);
                MessageService.SetSuccess("Post updated successfully!");
            }
            else
            {
                await PostsAdminFacade.CreatePostAsync(post);
                MessageService.SetSuccess("Post created successfully!");
            }

            // Navigate back to posts list after a short delay to show success message
            await Task.Delay(1500);
            Navigation.NavigateTo("/admin/posts");
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to save post. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/posts");
    }

    private void ShowPublishNowDialog()
    {
        DialogService.ShowConfirmationAsync(
            "Publish Now",
            "This will publish the post immediately. Are you sure?",
            ConfirmPublishNow,
            "Publish",
            "Cancel");
    }

    private void ShowPublishLaterDialog()
    {
        DialogService.ShowConfirmationAsync(
            "Schedule Publication",
            "This will schedule the post for publication at the selected date and time. Are you sure?",
            ConfirmPublishLater,
            "Schedule",
            "Cancel");
    }

    private void ShowUnpublishDialog()
    {
        DialogService.ShowConfirmationAsync(
            "Unpublish Post",
            "This will remove the post from public view. Are you sure?",
            ConfirmUnpublish,
            "Unpublish",
            "Cancel");
    }

    private async Task ConfirmPublishNow()
    {
        _model.PublishedAt = DateTimeOffset.Now;
        _model.IsPublished = true;
        await SavePublicationStateAsync();
    }

    private async Task ConfirmPublishLater()
    {
        // Set to tomorrow at noon if current date is in the past or too close to now
        var now = DateTimeOffset.Now;
        if (_model.PublishedAt <= now.AddMinutes(5))
        {
            _model.PublishedAt = now.Date.AddDays(1).AddHours(12);
        }
        _model.IsPublished = true;
        await SavePublicationStateAsync();
    }

    private async Task ConfirmUnpublish()
    {
        _model.IsPublished = false;
        await SavePublicationStateAsync();
    }

    private async Task SavePublicationStateAsync()
    {
        if (!_isEditMode || string.IsNullOrWhiteSpace(Id))
        {
            // For new posts, just update the model - will be saved when user clicks Create Post
            StateHasChanged();
            return;
        }

        try
        {
            _isSaving = true;
            StateHasChanged();
            MessageService.Clear();

            // Load the current post to get all data
            var post = await PostsAdminFacade.GetPostByIdAsync(Id!);
            
            if (post == null)
            {
                MessageService.SetFail("Post not found.");
                return;
            }

            // Update only the publication state
            post.IsPublished = _model.IsPublished;
            post.PublishedAt = _model.PublishedAt;
            post.UpdatedAt = DateTimeOffset.UtcNow;

            await PostsAdminFacade.UpdatePostAsync(post, CancellationToken.None);
            
            MessageService.SetSuccess(
                _model.IsPublished 
                    ? (_model.PublishedAt > DateTimeOffset.UtcNow ? "Post scheduled successfully!" : "Post published successfully!")
                    : "Post unpublished successfully!");
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to update publication state. Please try again.");
            
            // Reload the post to revert local changes
            await LoadPostAsync();
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}
