@page "/admin/posts/new"
@page "/admin/posts/edit/{id}"
@attribute [Authorize(Policy = RequirePostWrite)]
@using Viblog.Admin.Components
@using Viblog.Admin.Components.Input
@using Viblog.Admin.Extensions
@using Viblog.Admin.Models
@using Viblog.Admin.Services
@using Viblog.Frontend.Infrastructure
@using Viblog.Infrastructure.Admin.Facades
@using Viblog.Infrastructure.Shared.Data.Entities
@using Viblog.Infrastructure.Shared.Data.Entities.Content
@using Viblog.Shared.Services
@using Viblog.Shared.Extensions
@using Viblog.Infrastructure.Shared.Extensions

@using Microsoft.AspNetCore.Components.Authorization

@inject IPostsAdminFacade PostsAdminFacade
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITextUtilities TextUtilities
@inject IMessageService MessageService
@inject IDialogService DialogService

<div class="page-header">
    <h1>@(_isEditMode ? "Edit Post" : "Create New Post")</h1>

    @if (!_isLoading)
    {
        <div class="page-actions">
            @if (_isEditMode && _post != null)
            {
                <ContentStatusBadge IsPublished="@_post.IsPublished"
                                    HasPendingUpdate="@_post.HasPendingUpdate"
                                    ScheduleStatus="@_post.Schedule.Status"
                                    ScheduledDate="@_post.Schedule.ScheduledPublishDate"
                                    PublishedAt="@_post.PublishedAt"
                                    IsDeleted="@_post.IsDeleted" />
            }

            @if (_post?.IsDeleted != true)
            {
                @if (_isEditMode && _post != null)
                {
                    var isScheduled = _post.Schedule.Status == ContentStatus.Scheduled;

                    @if (_post.Live == null)
                    {
                        <button type="button" class="@GetPublishNowCssClass()" @onclick="HandlePublishNowClickAsync" disabled="@_isSaving">
                            @(_confirmPublishNow ? "Click to confirm" : "Publish Now")
                        </button>
                        @if (!isScheduled)
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowScheduleDialogAsync" disabled="@_isSaving">
                                Schedule
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowChangeTimeDialogAsync" disabled="@_isSaving">
                                Change Time
                            </button>
                            <button type="button" class="btn-action btn-cancel-schedule" @onclick="CancelScheduleAsync" disabled="@_isSaving">
                                Cancel Schedule
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button" class="@GetPublishNowCssClass()" @onclick="HandlePublishNowClickAsync" disabled="@_isSaving">
                            @(_confirmPublishNow ? "Click to confirm" : "Publish Update Now")
                        </button>
                        @if (!isScheduled)
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowScheduleDialogAsync" disabled="@_isSaving">
                                Schedule Update
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-action btn-schedule" @onclick="ShowChangeTimeDialogAsync" disabled="@_isSaving">
                                Change Time
                            </button>
                            <button type="button" class="btn-action btn-cancel-schedule" @onclick="CancelScheduleAsync" disabled="@_isSaving">
                                Cancel Schedule
                            </button>
                        }
                        <button type="button" class="btn-action btn-unpublish" @onclick="ShowUnpublishDialogAsync" disabled="@_isSaving">
                            Unpublish
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(_currentUserId) && _post.AuthorId != _currentUserId)
                    {
                        <button type="button" class="btn-action btn-adopt" @onclick="AdoptAsync" disabled="@_isSaving">
                            Adopt
                        </button>
                    }
                }

                <button type="submit" form="edit-post-form" class="btn-primary" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(_isEditMode ? "Update Post" : "Create Post")</span>
                    }
                </button>

                <button type="button" class="btn-secondary" @onclick="Cancel" disabled="@_isSaving">
                    Cancel
                </button>
            }
        </div>
    }
</div>

@if (_post?.IsDeleted == true)
{
    <div class="deleted-banner">
        <p>This post has been deleted and is read-only.</p>
    </div>
}

<ScheduleTimePicker @bind-Visible="_scheduleDialogVisible"
                    Title="@(_post?.Schedule.Status == ContentStatus.Scheduled ? "Change Scheduled Time" : "Schedule Publication")"
                    InitialDate="@_scheduleInitialDate"
                    OnConfirm="OnScheduleConfirmedAsync" />

@if (_isLoading)
{
    <div class="loading">
        <p>Loading...</p>
    </div>
}
else
{
    <EditForm id="edit-post-form" Model="@_model" OnValidSubmit="HandleValidSubmit" class="edit-post-form">
        <DataAnnotationsValidator />
        
        <FormSection Title="Basic Information & Publishing">
            <div class="form-grid-three">
                <div class="form-column">
                    <TextInput @bind-Value="_model.Title"
                              OnBlur="@HandleTitleBlur"
                              Label="Title"
                              Placeholder="Enter post title"
                              Required="true"
                              ValidationFor="@(() => _model.Title)" />

                    <TextInput @bind-Value="_model.Slug"
                              Label="Slug"
                              Placeholder="url-friendly-slug"
                              Required="true"
                              ValidationFor="@(() => _model.Slug)" />

                    <TextInput @bind-Value="_model.Short"
                              Label="Summary"
                              Placeholder="Brief summary of the post"
                              Multiline="true"
                              Rows="3"
                              ValidationFor="@(() => _model.Short)" />
                </div>

                <div class="form-column">
                    <CheckboxInput @bind-Value="_model.IsFeatured"
                                 Label="Featured Post" />

                    <TagInput @bind-Tags="_model.Tags"
                              Label="Tags"
                              HelpText="Press Enter to add a tag" />
                </div>

                <div class="form-column">
                    <TextInput @bind-Value="_model.AuthorName"
                              Label="Author Name"
                              Placeholder="Author name"
                              Required="true"
                              Disabled="@_isEditMode"
                              ValidationFor="@(() => _model.AuthorName)" />

                    <TextInput @bind-Value="_model.FeaturedImageUrl"
                              Label="Featured Image URL (optional)"
                              Placeholder="https://example.com/image.jpg"
                              ValidationFor="@(() => _model.FeaturedImageUrl)" />

                    <TextInput @bind-Value="_model.FeaturedImageAlt"
                              Label="Featured Image Alt Text"
                              Placeholder="Description of the image"
                              ValidationFor="@(() => _model.FeaturedImageAlt)" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Content">
            <MarkdownEditor @bind-Markdown="_model.Markdown"
                          @bind-RenderedContent="_model.Content"
                          Label="Post Content (optional for 'short' posts)"
                          Placeholder="Write your post content in markdown..."
                          Rows="20" />
        </FormSection>

        @if (_isEditMode && !string.IsNullOrWhiteSpace(Id))
        {
            <FormSection Title="Activity History">
                <AuditLogPanel EntityType="EntityType.BlogPost" EntityId="@Id" PageSize="20" />
            </FormSection>
        }
    </EditForm>
}

@code {
    private BlogPostModel _model = new();
    private BlogPost? _post;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditMode;
    private bool _scheduleDialogVisible;
    private DateTimeOffset? _scheduleInitialDate;
    private bool _confirmPublishNow;
    private string _currentUserId = string.Empty;

    [Parameter]
    public string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _isEditMode = !string.IsNullOrWhiteSpace(Id);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        if (_isEditMode)
        {
            await LoadPostAsync();
        }
        else
        {
            var userName = authState.User.Identity?.Name ?? "Anonymous";
            _model = new BlogPostModel { AuthorName = userName };
            _isLoading = false;
        }
    }

    private async Task LoadPostAsync()
    {
        try
        {
            _isLoading = true;
            MessageService.Clear();
            _confirmPublishNow = false;

            var post = await PostsAdminFacade.GetPostByIdAsync(Id!);

            if (post == null)
            {
                MessageService.SetFail("Post not found.");
                return;
            }

            _post = post;
            _model = post.ToModel();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to load post. Please try again.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleTitleBlur(FocusEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_model.Slug))
        {
            _model.Slug = TextUtilities.Slugify(_model.Title) ?? string.Empty;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (_post?.IsDeleted == true) return;

        try
        {
            _isSaving = true;
            _confirmPublishNow = false;
            MessageService.Clear();

            if (_isEditMode && _post != null)
            {
                // Update only the draft fields; leave Live, Schedule, PublishedAt etc. intact
                _post.Draft.Title = _model.Title;
                _post.Draft.Short = _model.Short;
                _post.Draft.Markdown = _model.Markdown;
                _post.Draft.Content = _model.Content ?? string.Empty;
                _post.Draft.FeaturedImageUrl = _model.FeaturedImageUrl;
                _post.Draft.FeaturedImageAlt = _model.FeaturedImageAlt;
                _post.Slug = _model.Slug;
                _post.IsFeatured = _model.IsFeatured;
                _post.Tags = _model.Tags;
                _post.CategoryIds = _model.CategoryIds;
                _post.UpdatedAt = DateTimeOffset.UtcNow;

                await PostsAdminFacade.UpdatePostAsync(_post);
                MessageService.SetSuccess("Post saved successfully!");
                await LoadPostAsync();
            }
            else
            {
                var post = _model.ToEntity();
                await PostsAdminFacade.CreatePostAsync(post);
                MessageService.SetSuccess("Post created successfully!");
                await Task.Delay(1500);
                Navigation.NavigateTo("/admin/posts");
            }
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to save post. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/admin/posts");

    // Publish Now — two-step inline confirmation
    private async Task HandlePublishNowClickAsync()
    {
        if (!_confirmPublishNow)
        {
            _confirmPublishNow = true;
            return;
        }

        _confirmPublishNow = false;
        await ExecutePublishNowAsync();
    }

    private async Task ExecutePublishNowAsync()
    {
        try
        {
            _isSaving = true;
            StateHasChanged();
            await PostsAdminFacade.PublishPostNowAsync(Id!);
            MessageService.SetSuccess(_post?.Live == null ? "Post published successfully!" : "Draft update published successfully!");
            await LoadPostAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to publish post. Please try again.");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    // Schedule / Change Time
    private Task ShowScheduleDialogAsync()
    {
        _confirmPublishNow = false;
        _scheduleInitialDate = null;
        _scheduleDialogVisible = true;
        return Task.CompletedTask;
    }

    private Task ShowChangeTimeDialogAsync()
    {
        _confirmPublishNow = false;
        _scheduleInitialDate = _post?.Schedule.ScheduledPublishDate;
        _scheduleDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task OnScheduleConfirmedAsync(DateTimeOffset date)
    {
        try
        {
            _isSaving = true;
            await PostsAdminFacade.SchedulePostAsync(Id!, date);
            MessageService.SetSuccess($"Post scheduled for {date:MMM d, yyyy 'at' HH:mm} UTC.");
            await LoadPostAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to schedule post. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Cancel Schedule
    private async Task CancelScheduleAsync()
    {
        _confirmPublishNow = false;
        try
        {
            _isSaving = true;
            await PostsAdminFacade.CancelPostScheduleAsync(Id!);
            MessageService.SetSuccess("Schedule cancelled.");
            await LoadPostAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to cancel schedule. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Unpublish — modal confirmation
    private void ShowUnpublishDialogAsync()
    {
        _confirmPublishNow = false;
        DialogService.ShowConfirmationAsync(
            "Unpublish Post",
            "This will remove the post from public view. Your draft will be preserved. Are you sure?",
            ConfirmUnpublishAsync,
            "Unpublish",
            "Cancel");
    }

    private async Task ConfirmUnpublishAsync()
    {
        try
        {
            _isSaving = true;
            await InvokeAsync(StateHasChanged);
            await PostsAdminFacade.UnpublishPostAsync(Id!);
            MessageService.SetSuccess("Post unpublished successfully.");
            await LoadPostAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to unpublish post. Please try again.");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Adopt
    private async Task AdoptAsync()
    {
        _confirmPublishNow = false;
        try
        {
            _isSaving = true;
            await PostsAdminFacade.AdoptPostAsync(Id!);
            MessageService.SetSuccess("Post ownership transferred to you.");
            await LoadPostAsync();
        }
        catch (Exception ex)
        {
            MessageService.SetError(ex, "Failed to adopt post. Please try again.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string GetPublishNowCssClass() =>
        _confirmPublishNow ? "btn-action btn-publish-now btn-confirm-active" : "btn-action btn-publish-now";
}

