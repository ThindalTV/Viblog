@page "/posts"
@page "/posts/{PageNumber:int}"
@layout Vilog.Frontend.Layout.BlogLayout
@using Vilog.Frontend.Components
@using Vilog.Frontend.Infrastructure
@using Vilog.Shared.Data.Common
@using Vilog.Shared.Data.Entities

@inject IBlogPostListFacade BlogPostListFacade
@inject NavigationManager Navigation

<PageTitle>All Posts</PageTitle>

<section class="blog-section">
    <h2 class="section-title">All Blog Posts</h2>
    
    @if (_isLoading)
    {
        <p class="loading-message">Loading posts...</p>
    }
    else if (_errorMessage != null)
    {
        <p class="error-message">@_errorMessage</p>
    }
    else if (_pagedResult == null || !_pagedResult.Items.Any())
    {
        <article class="blog-post">
            <h3 class="post-title">No Posts Yet</h3>
            <p class="post-excerpt">
                Check back soon for new content!
            </p>
        </article>
    }
    else
    {
        @foreach (var post in _pagedResult.Items)
        {
            <PostCard Post="post" />
        }

        <Pagination PagedResult="@_pagedResult"
                    GetPageUrl="@GetPageUrl"
                    AriaLabel="Blog posts pagination"
                    ItemName="posts" />
    }
</section>

@code {
    private const int PostsPerPage = 5;
    
    private PagedResult<BlogPost>? _pagedResult;
    private bool _isLoading = true;
    private string? _errorMessage;

    [Parameter]
    public int? PageNumber { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var newPage = PageNumber ?? 1;
        if (newPage != (PageNumber ?? 1))
        {
            await LoadPostsAsync();
        }
    }

    private async Task LoadPostsAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            
            var currentPage = PageNumber ?? 1;
            var pagingParams = new PagingParameters(currentPage, PostsPerPage);
            _pagedResult = await BlogPostListFacade.GetPaginatedPostsAsync(pagingParams);
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to load blog posts. Please try again later.";
            // In production, log the exception
            // Logger.LogError(ex, "Error loading paginated posts");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetPageUrl(int pageNumber)
    {
        if (pageNumber < 1)
        {
            pageNumber = 1;
        }

        if (_pagedResult != null && pageNumber > _pagedResult.TotalPages)
        {
            pageNumber = _pagedResult.TotalPages;
        }

        return pageNumber == 1 
            ? "/posts" 
            : $"/posts/{pageNumber}";
    }
}
