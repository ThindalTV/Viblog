@page "/"
@layout Viblog.Frontend.Layout.BlogLayout
@using Viblog.Frontend.Components
@using Viblog.Frontend.Components.Metadata
@attribute [ShowProfileHeader]

@inject IFrontPageFacade FrontPageFacade

<HomeSeoHead />

<section class="blog-section">
    <h2 class="section-title">Latest Posts</h2>
    
    @if (_isLoading)
    {
        <p class="loading-message">Loading posts...</p>
    }
    else if (_errorMessage != null)
    {
        <p class="error-message">@_errorMessage</p>
    }
    else if (!_posts.Any())
    {
        <article class="blog-post">
            <h3 class="post-title">No Posts Yet</h3>
            <p class="post-excerpt">
                Check back soon for new content!
            </p>
        </article>
    }
    else
    {
        @foreach (var post in _posts)
        {
            <PostCard Post="post" />
        }
        
        <div class="view-all-posts">
            <a href="/posts" class="view-all-link">View All Posts ?</a>
        </div>
    }
</section>

<section class="blog-section">
    <h2 class="section-title">About</h2>
    <p>
        This is where you can add more information about yourself, your background, 
        and what readers can expect from your blog.
    </p>
</section>

@code {
    private IEnumerable<BlogPost> _posts = Enumerable.Empty<BlogPost>();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            _posts = await FrontPageFacade.GetFrontPagePostsAsync(maxPosts: 8);
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to load blog posts. Please try again later.";
            // In production, log the exception
            // Logger.LogError(ex, "Error loading front page posts");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
