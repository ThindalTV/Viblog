@using Vilog.Frontend.Components.Metadata
@using Vilog.Shared.Configuration
@using Microsoft.Extensions.Options
@using static Vilog.Frontend.Components.Metadata.StructuredData

@inject IOptions<SiteMetadata> SiteMetadataOptions

<SeoHead 
    Title="@(Title ?? SiteMetadataOptions.Value.Tagline)"
    Description="@(Description ?? SiteMetadataOptions.Value.DefaultDescription)"
    CanonicalUrl="@(CanonicalUrl ?? SiteMetadataOptions.Value.BaseUrl)"
    OgType="website"
    ImageUrl="@(ImageUrl ?? SiteMetadataOptions.Value.DefaultImageUrl)">
    
    <StructuredData Type="StructuredDataType.WebSite" />
    <StructuredData Type="StructuredDataType.Organization" />
    
    @ChildContent
</SeoHead>

@code {
    /// <summary>
    /// Optional custom title (defaults to site tagline)
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Optional custom description (defaults to site default description)
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Optional custom canonical URL (defaults to base URL)
    /// </summary>
    [Parameter]
    public string? CanonicalUrl { get; set; }

    /// <summary>
    /// Optional custom image URL (defaults to site default image)
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>
    /// Additional structured data or head content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
