@using Microsoft.Extensions.Options
@using Viblog.Shared.Configuration
@using Viblog.Frontend.Models

@inject IOptions<SiteMetadata> SiteMetadataOptions

<PageTitle>@GetFullTitle()</PageTitle>

<HeadContent>
    <!-- Basic Meta Tags -->
    <meta name="description" content="@(Description ?? SiteMetadata.DefaultDescription)" />
    @if (!string.IsNullOrWhiteSpace(Keywords))
    {
        <meta name="keywords" content="@Keywords" />
    }
    @if (!string.IsNullOrWhiteSpace(Author))
    {
        <meta name="author" content="@Author" />
    }
    <link rel="canonical" href="@CanonicalUrl" />

    <!-- Open Graph Tags -->
    <meta property="og:site_name" content="@SiteMetadata.SiteName" />
    <meta property="og:title" content="@(Title ?? SiteMetadata.SiteName)" />
    <meta property="og:description" content="@(Description ?? SiteMetadata.DefaultDescription)" />
    <meta property="og:type" content="@OgType" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:locale" content="@SiteMetadata.Locale" />
    @if (!string.IsNullOrWhiteSpace(ImageUrl ?? SiteMetadata.DefaultImageUrl))
    {
        <meta property="og:image" content="@(ImageUrl ?? SiteMetadata.DefaultImageUrl)" />
        @if (!string.IsNullOrWhiteSpace(ImageAlt))
        {
            <meta property="og:image:alt" content="@ImageAlt" />
        }
    }
    @if (!string.IsNullOrWhiteSpace(SiteMetadata.FacebookAppId))
    {
        <meta property="fb:app_id" content="@SiteMetadata.FacebookAppId" />
    }
    @if (PublishedTime.HasValue)
    {
        <meta property="article:published_time" content="@PublishedTime.Value.ToString("yyyy-MM-ddTHH:mm:ssZ")" />
    }
    @if (ModifiedTime.HasValue)
    {
        <meta property="article:modified_time" content="@ModifiedTime.Value.ToString("yyyy-MM-ddTHH:mm:ssZ")" />
    }
    @if (!string.IsNullOrWhiteSpace(ArticleAuthor))
    {
        <meta property="article:author" content="@ArticleAuthor" />
    }
    @if (ArticleTags != null && ArticleTags.Any())
    {
        @foreach (var tag in ArticleTags)
        {
            <meta property="article:tag" content="@tag" />
        }
    }

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="@TwitterCardType" />
    <meta name="twitter:title" content="@(Title ?? SiteMetadata.SiteName)" />
    <meta name="twitter:description" content="@(Description ?? SiteMetadata.DefaultDescription)" />
    @if (!string.IsNullOrWhiteSpace(SiteMetadata.TwitterHandle))
    {
        <meta name="twitter:site" content="@@@SiteMetadata.TwitterHandle" />
        <meta name="twitter:creator" content="@@@SiteMetadata.TwitterHandle" />
    }
    @if (!string.IsNullOrWhiteSpace(ImageUrl ?? SiteMetadata.DefaultImageUrl))
    {
        <meta name="twitter:image" content="@(ImageUrl ?? SiteMetadata.DefaultImageUrl)" />
        @if (!string.IsNullOrWhiteSpace(ImageAlt))
        {
            <meta name="twitter:image:alt" content="@ImageAlt" />
        }
    }
    @if (TwitterMetadataItems != null && TwitterMetadataItems.Any())
    {
        @for (int i = 0; i < Math.Min(TwitterMetadataItems.Count, 2); i++)
        {
            var item = TwitterMetadataItems[i];
            var labelNum = i + 1;
            <meta name="twitter:label@(labelNum)" content="@item.Label" />
            <meta name="twitter:data@(labelNum)" content="@item.Data" />
        }
    }

    <!-- Additional SEO Tags -->
    <meta name="robots" content="@RobotsContent" />
</HeadContent>

@code {
    private SiteMetadata SiteMetadata => SiteMetadataOptions.Value;

    /// <summary>
    /// Page title (will be appended to site name)
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Page description for meta tags
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Canonical URL for the page
    /// </summary>
    [Parameter]
    public string CanonicalUrl { get; set; } = string.Empty;

    /// <summary>
    /// Keywords for meta keywords tag
    /// </summary>
    [Parameter]
    public string? Keywords { get; set; }

    /// <summary>
    /// Author name
    /// </summary>
    [Parameter]
    public string? Author { get; set; }

    /// <summary>
    /// Image URL for social sharing
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>
    /// Alt text for the image
    /// </summary>
    [Parameter]
    public string? ImageAlt { get; set; }

    /// <summary>
    /// Open Graph type (website, article, etc.)
    /// </summary>
    [Parameter]
    public string OgType { get; set; } = "website";

    /// <summary>
    /// Published time for articles
    /// </summary>
    [Parameter]
    public DateTimeOffset? PublishedTime { get; set; }

    /// <summary>
    /// Modified time for articles
    /// </summary>
    [Parameter]
    public DateTimeOffset? ModifiedTime { get; set; }

    /// <summary>
    /// Article author name
    /// </summary>
    [Parameter]
    public string? ArticleAuthor { get; set; }

    /// <summary>
    /// Article tags
    /// </summary>
    [Parameter]
    public IEnumerable<string>? ArticleTags { get; set; }

    /// <summary>
    /// Twitter card type (summary or summary_large_image)
    /// </summary>
    [Parameter]
    public string TwitterCardType { get; set; } = "summary";

    /// <summary>
    /// List of Twitter Card metadata items (label/data pairs). Maximum of 2 items supported by Twitter.
    /// </summary>
    [Parameter]
    public List<TwitterMetadata>? TwitterMetadataItems { get; set; }

    /// <summary>
    /// Robots meta tag content
    /// </summary>
    [Parameter]
    public string RobotsContent { get; set; } = "index, follow";

    /// <summary>
    /// Get the full page title with site name
    /// </summary>
    private string GetFullTitle()
    {
        if (string.IsNullOrWhiteSpace(Title))
            return SiteMetadata.SiteName;

        return $"{Title} | {SiteMetadata.SiteName}";
    }
}
