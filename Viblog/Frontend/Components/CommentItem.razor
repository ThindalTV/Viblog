@using Vilog.Frontend.Infrastructure


<article class="comment @(IsReply ? "comment-reply" : "")" id="comment-@Comment.Id">
    <div class="comment-header">
        <div class="comment-author">
            @if (!string.IsNullOrEmpty(Comment.AuthorWebsite))
            {
                <a href="@Comment.AuthorWebsite" target="_blank" rel="nofollow noopener" class="author-link">
                    @Comment.AuthorName
                </a>
            }
            else
            {
                <span class="author-name">@Comment.AuthorName</span>
            }
        </div>
        <div class="comment-meta">
            <time datetime="@Comment.CreatedAt.ToString("o")" class="comment-date">
                @FormatDate(Comment.CreatedAt)
            </time>
            @if (Comment.IsEdited)
            {
                <span class="comment-edited" title="Last edited @Comment.UpdatedAt?.ToString("g")">(edited)</span>
            }
        </div>
    </div>
    
    <div class="comment-content">
        @Comment.Content
    </div>
    
    <div class="comment-actions">
        <button type="button" class="reply-button" @onclick="HandleReplyClick">
            Reply
        </button>
    </div>

    @if (Comment.Replies.Any())
    {
        <div class="comment-replies">
            @foreach (var reply in Comment.Replies)
            {
                <CommentItem Comment="reply" IsReply="true" OnReply="OnReply" />
            }
        </div>
    }
</article>

@code {
    /// <summary>
    /// The comment to display
    /// </summary>
    [Parameter, EditorRequired]
    public CommentViewModel Comment { get; set; } = null!;

    /// <summary>
    /// Whether this is a reply to another comment
    /// </summary>
    [Parameter]
    public bool IsReply { get; set; }

    /// <summary>
    /// Event callback when user clicks reply
    /// </summary>
    [Parameter]
    public EventCallback<CommentViewModel> OnReply { get; set; }

    private async Task HandleReplyClick()
    {
        await OnReply.InvokeAsync(Comment);
    }

    private static string FormatDate(DateTimeOffset date)
    {
        var timeAgo = DateTimeOffset.UtcNow - date;

        if (timeAgo.TotalMinutes < 1)
            return "just now";
        if (timeAgo.TotalMinutes < 60)
            return $"{(int)timeAgo.TotalMinutes} minute{((int)timeAgo.TotalMinutes == 1 ? "" : "s")} ago";
        if (timeAgo.TotalHours < 24)
            return $"{(int)timeAgo.TotalHours} hour{((int)timeAgo.TotalHours == 1 ? "" : "s")} ago";
        if (timeAgo.TotalDays < 7)
            return $"{(int)timeAgo.TotalDays} day{((int)timeAgo.TotalDays == 1 ? "" : "s")} ago";
        if (timeAgo.TotalDays < 30)
            return $"{(int)(timeAgo.TotalDays / 7)} week{((int)(timeAgo.TotalDays / 7) == 1 ? "" : "s")} ago";
        
        return date.ToString("MMMM d, yyyy");
    }
}
