@using Vilog.Shared.Data.Common

@if (PagedResult != null && PagedResult.TotalPages > 1)
{
    <nav class="pagination" aria-label="@AriaLabel">
        @if (ShowInfo)
        {
            <div class="pagination-info">
                Page @PagedResult.PageNumber of @PagedResult.TotalPages (@PagedResult.TotalCount total @ItemName)
            </div>
        }
        <div class="pagination-controls">
            <a href="@GetPageUrl(1)" 
               class="pagination-btn @(!PagedResult.HasPreviousPage ? "disabled" : "")" 
               aria-label="First page"
               aria-disabled="@(!PagedResult.HasPreviousPage)">
                First
            </a>
            <a href="@GetPageUrl(PagedResult.PageNumber - 1)" 
               class="pagination-btn @(!PagedResult.HasPreviousPage ? "disabled" : "")" 
               aria-label="Previous page"
               aria-disabled="@(!PagedResult.HasPreviousPage)">
                Previous
            </a>
            
            @foreach (var pageNum in GetPageNumbers())
            {
                <a href="@GetPageUrl(pageNum)" 
                   class="pagination-btn @(pageNum == PagedResult.PageNumber ? "active" : "")" 
                   aria-label="Page @pageNum"
                   aria-current="@(pageNum == PagedResult.PageNumber ? "page" : null)">
                    @pageNum
                </a>
            }
            
            <a href="@GetPageUrl(PagedResult.PageNumber + 1)" 
               class="pagination-btn @(!PagedResult.HasNextPage ? "disabled" : "")" 
               aria-label="Next page"
               aria-disabled="@(!PagedResult.HasNextPage)">
                Next
            </a>
            <a href="@GetPageUrl(PagedResult.TotalPages)" 
               class="pagination-btn @(!PagedResult.HasNextPage ? "disabled" : "")" 
               aria-label="Last page"
               aria-disabled="@(!PagedResult.HasNextPage)">
                Last
            </a>
        </div>
    </nav>
}

@code {
    /// <summary>
    /// The paged result containing pagination information
    /// </summary>
    [Parameter]
    public PagedResultBase? PagedResult { get; set; }

    /// <summary>
    /// Function to generate URL for a specific page number
    /// </summary>
    [Parameter]
    public Func<int, string> GetPageUrl { get; set; } = _ => "#";

    /// <summary>
    /// Aria label for the navigation element
    /// </summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Pagination";

    /// <summary>
    /// Maximum number of page buttons to show
    /// </summary>
    [Parameter]
    public int MaxPagesToShow { get; set; } = 5;

    /// <summary>
    /// Whether to show the pagination info text
    /// </summary>
    [Parameter]
    public bool ShowInfo { get; set; } = true;

    /// <summary>
    /// Name of the items being paginated (e.g., "posts", "results")
    /// </summary>
    [Parameter]
    public string ItemName { get; set; } = "items";

    private IEnumerable<int> GetPageNumbers()
    {
        if (PagedResult == null)
        {
            yield break;
        }

        var startPage = Math.Max(1, PagedResult.PageNumber - MaxPagesToShow / 2);
        var endPage = Math.Min(PagedResult.TotalPages, startPage + MaxPagesToShow - 1);

        if (endPage - startPage < MaxPagesToShow - 1)
        {
            startPage = Math.Max(1, endPage - MaxPagesToShow + 1);
        }

        for (var i = startPage; i <= endPage; i++)
        {
            yield return i;
        }
    }
}
