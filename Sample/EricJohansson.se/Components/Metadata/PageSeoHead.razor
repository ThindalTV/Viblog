@using Viblog.Infrastructure.Shared.Data.Entities
@using EricJohansson.se.Components.Metadata
@using static EricJohansson.se.Components.Metadata.StructuredData
@using PageEntity = Viblog.Infrastructure.Shared.Data.Entities.Page

<SeoHead 
    Title="@Page.Live?.Title"
    Description="@Page.Live?.MetaDescription"
    CanonicalUrl="@CanonicalUrl"
    Keywords="@Page.Live?.MetaKeywords"
    Author="@Page.AuthorName"
    ImageUrl="@Page.Live?.FeaturedImageUrl"
    ImageAlt="@Page.Live?.FeaturedImageAlt"
    OgType="website"
    TwitterCardType="@(string.IsNullOrWhiteSpace(Page.Live?.FeaturedImageUrl) ? "summary" : "summary_large_image")">

    <StructuredData Type="StructuredDataType.CollectionPage" 
                   Title="@Page.Live?.Title" 
                   Description="@Page.Live?.MetaDescription"
                   Url="@CanonicalUrl" />
</SeoHead>

@code {
    /// <summary>
    /// The page to generate SEO metadata for
    /// </summary>
    [Parameter, EditorRequired]
    public PageEntity Page { get; set; } = default!;

    /// <summary>
    /// The canonical URL for the page
    /// </summary>
    [Parameter, EditorRequired]
    public string CanonicalUrl { get; set; } = string.Empty;
}
