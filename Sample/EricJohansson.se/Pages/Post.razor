@page "/post/{year:int}/{slug}"
@layout EricJohansson.se.Layout.BlogLayout
@using EricJohansson.se.Components
@using EricJohansson.se.Components.Metadata
@using Microsoft.Extensions.Logging
@using Viblog.Infrastructure.Shared.Data.Entities.Content

@inject IBlogPostDetailFacade BlogPostDetailFacade
@inject NavigationManager Navigation
@inject ILogger<Post> Logger

@if (_isLoading)
{
    <div class="post-loading">
        <p class="loading-message">Loading post...</p>
    </div>
}
else if (_errorMessage != null)
{
    <div class="post-error">
        <h2>Error</h2>
        <p class="error-message">@_errorMessage</p>
        <a href="/" class="back-link">&larr; Back to Home</a>
    </div>
}
else if (_post == null)
{
    <div class="post-not-found">
        <h2>Post Not Found</h2>
        <p>The post you're looking for doesn't exist or has been removed.</p>
        <a href="/posts" class="back-link">&larr; View All Posts</a>
    </div>
}
else
{
    <PostSeoHead Post="@_post" CanonicalUrl="@GetCanonicalUrl()" BreadcrumbItems="@_breadcrumbItems" />

    <Breadcrumb Items="_breadcrumbItems" />

    @if (!string.IsNullOrWhiteSpace(Content?.FeaturedImageUrl))
    {
        <div class="post-featured-image">
            <img src="@Content?.FeaturedImageUrl"
                 alt="@(Content?.FeaturedImageAlt ?? Content?.Title)" />
        </div>
    }

    <article class="post-detail">
        @if (_post.IsFeatured)
        {
            <span class="featured-badge">Featured</span>
        }

        <header class="post-header">
            <h1 class="post-detail-title">@Content?.Title</h1>
            
            <div class="post-detail-meta">
                <span class="post-author">By @_post.AuthorName</span>
                <span class="post-date">@_post.PublishedAt?.ToString("MMMM dd, yyyy")</span>
                @if (_post.ReadingTimeMinutes > 0)
                {
                    <span class="reading-time">@_post.ReadingTimeMinutes min read</span>
                }
                @if (_post.ViewCount > 0)
                {
                    <span class="view-count">@_post.ViewCount views</span>
                }
            </div>

            @if (_post.CategoryNames.Any())
            {
                <div class="post-categories">
                    @foreach (var category in _post.CategoryNames)
                    {
                        <a href="/category/@Uri.EscapeDataString(category)" class="category">@category</a>
                    }
                </div>
            }
        </header>

        <div class="post-content">
            @((MarkupString)(Content?.Content ?? ""))
        </div>

        <SocialShare Title="@Content?.Title" Url="@GetCanonicalUrl()" />

        <ShortPostList Posts="_relatedPosts" Title="Related Posts" />

        @if (_post.Tags.Any())
        {
            <footer class="post-footer">
                <div class="post-tags-section">
                    <h3>Tags</h3>
                    <div class="post-tags">
                        @foreach (var tag in _post.Tags)
                        {
                            <a href="/tag/@Uri.EscapeDataString(tag)" class="tag">@tag</a>
                        }
                    </div>
                </div>
            </footer>
        }

        <nav class="post-navigation">
            @if (_previousPost != null)
            {
                <a href="/post/@_previousPost.PublishedAt?.Year/@_previousPost.Slug" class="post-nav-link post-nav-prev">
                    <span class="post-nav-label">&larr; Previous</span>
                    <span class="post-nav-title">@(_previousPost.Live?.Title ?? _previousPost.Draft.Title)</span>
                </a>
            }
            else
            {
                <span class="post-nav-placeholder"></span>
            }

            <a href="/posts" class="post-nav-all">All Posts</a>

            @if (_nextPost != null)
            {
                <a href="/post/@_nextPost.PublishedAt?.Year/@_nextPost.Slug" class="post-nav-link post-nav-next">
                    <span class="post-nav-label">Next &rarr;</span>
                    <span class="post-nav-title">@(_nextPost.Live?.Title ?? _nextPost.Draft.Title)</span>
                </a>
            }
            else
            {
                <span class="post-nav-placeholder"></span>
            }
        </nav>
    </article>
}

@code {
    private BlogPost? _post;
    private BlogPost? _previousPost;
    private BlogPost? _nextPost;
    private bool _isLoading = true;
    private string? _errorMessage;
    private List<Breadcrumb.BreadcrumbItem> _breadcrumbItems = new();
    private List<BlogPost> _relatedPosts = new();

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public int Year { get; set; }

    private BlogPostContent? Content;

    protected override async Task OnInitializedAsync()
    {
        await LoadPostAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            await LoadPostAsync();
        }
    }

    private async Task LoadPostAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            _post = await BlogPostDetailFacade.GetPostBySlugAsync(Slug);

            if (_post == null)
            {
                // Redirect to 404 page when post not found
                Navigation.NavigateTo("/not-found");
                return;
            }

            Content = _post.Live; // TODO: Change to draft for preview mode

            BuildBreadcrumbs();

            // Load related posts
            var related = await BlogPostDetailFacade.GetRelatedPostsAsync(Slug, maxPosts: 3);
            _relatedPosts = related.ToList();

            // Load adjacent posts for prev/next navigation
            if (_post.PublishedAt.HasValue)
            {
                (_previousPost, _nextPost) = await BlogPostDetailFacade.GetAdjacentPostsAsync(_post.PublishedAt.Value);
            }

            // Increment view count if post is found
            try
            {
                await BlogPostDetailFacade.IncrementViewCountAsync(_post.Id, _post.GroupKey);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to increment view count for post {Slug}", Slug);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to load the blog post. Please try again later.";
            Logger.LogError(ex, "Error loading post with slug: {Slug}", Slug);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildBreadcrumbs()
    {
        _breadcrumbItems = new List<Breadcrumb.BreadcrumbItem>
        {
            new() { Label = "Posts", Url = "/posts" },
            new() { Label = _post!.Live?.Title ?? _post!.Draft.Title, Url = $"/post/{Slug}" }
        };
    }

    private string GetCanonicalUrl()
    {
        return $"{Navigation.BaseUri}post/{Slug}";
    }
}
