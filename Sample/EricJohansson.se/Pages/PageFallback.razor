@using EricJohansson.se.Infrastructure.Facades
@using Microsoft.AspNetCore.Components.Routing
@inject IPageDetailFacade PageDetailFacade
@inject NavigationManager Navigation

@if (_isCheckingPage)
{
    <div class="loading-fallback">
        <p>Loading...</p>
    </div>
}
else if (_pageFound)
{
    <EricJohansson.se.Pages.PageView Slug="@_slug" />
}
else
{
    <EricJohansson.se.Pages.NotFound />
}

@code {
    private bool _isCheckingPage = true;
    private bool _pageFound = false;
    private string _slug = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckForPageAsync();
    }

    private async Task CheckForPageAsync()
    {
        try
        {
            _isCheckingPage = true;

            // Extract slug from current URL
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var path = uri.AbsolutePath.Trim('/');

            // Skip if path is empty (home page) or contains slashes (sub-paths that aren't pages)
            if (string.IsNullOrWhiteSpace(path) || path.Contains('/'))
            {
                _pageFound = false;
                return;
            }

            _slug = path;

            // Check if a page exists with this slug
            var page = await PageDetailFacade.GetPageBySlugAsync(_slug);
            _pageFound = page != null;
        }
        catch
        {
            // If there's an error checking for the page, show 404
            _pageFound = false;
        }
        finally
        {
            _isCheckingPage = false;
        }
    }
}
