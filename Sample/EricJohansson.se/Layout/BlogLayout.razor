@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using Telerik.Blazor.Components
@using EricJohansson.se.Components
@using EricJohansson.se.Models
@using System.Reflection

<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="blog-container">
    <header class="blog-header">
        <div class="header-top">
            <h1 class="header-name"><a href="/"><span class="name-full">Eric Johansson</span><span class="name-short">Eric</span></a></h1>
        </div>

        <ProfileHeader Show="@_shouldShowProfile"
                       Role="Developer Consultant Educator"
                       SocialLinks="@_socialLinks"
                       Awards="@_awards">
            <Bio>
                <p>
                    Eric has a broad experience that covers topics from ZX Basic to .NET. With projects spanning from
                    business applications to nuclear power plant systems he developed the ability to adapt and
                    evolve with the rapid changes in the tech landscape.
                </p>

                <img src="/img/profile.png" class="bio-inline-photo" alt="Eric Johansson" />

                <p>
                    That knowledge is something that he shares freely as a content creator and public speaker. Eric is passionate about making complex topics accessible to all level of learners, which you can see in his style of teaching in his livestreams, tutorials and conference sessions.
                </p>

                <p>
                    Apart from being a techie, he's also a servant to Zelda, an adorable cat.
                </p>
            </Bio>
        </ProfileHeader>
    </header>

    <div class="blog-content-wrapper">
        <main class="blog-main">
            @Body
        </main>
    </div>

    <footer class="blog-footer">
    </footer>
</div>

@code {
    private bool _shouldShowProfile;

    private readonly List<SocialLink> _socialLinks =
    [
        new("https://www.linkedin.com/in/eric-r-johansson/", "LinkedIn", "/img/socials/linkedin.svg"),
        new("https://github.com/thindal", "GitHub", "/img/socials/github.svg"),
        new("https://www.twitch.tv/thindal", "Twitch", "/img/socials/twitch.svg"),
        new("https://twitter.com/ericjohansson", "X (Twitter)", "/img/socials/x.svg"),
        new("https://bsky.app/profile/ericjohansson.bsky.social", "Bluesky", "/img/socials/bsky.svg"),
        new("https://sessionize.com/ericjohansson", "Sessionize", "/img/socials/sessionize.svg")
    ];

    private readonly List<Award> _awards =
    [
        new("/img/awards/microsoft-mvp.svg", "Microsoft MVP Award", "Microsoft MVP Award", "https://mvp.microsoft.com/en-US/mvp/profile/95be932c-7f7c-47ab-9f3c-53b44c0852aa"),
        new("/img/awards/telerik-champion.svg", "Progress Telerik Champion Award", "Progress Telerik Champion Award", "https://www.progress.com/champions")
    ];

    protected override void OnParametersSet()
    {
        // Check if the current page has the ShowProfileHeader attribute
        var uri = new Uri(Navigation.Uri);
        _shouldShowProfile = ShouldShowProfileForRoute(uri.LocalPath);
    }

    private bool ShouldShowProfileForRoute(string route)
    {
        // For the home page (root route), show the profile
        return route == "/" || route == string.Empty;
    }
}
